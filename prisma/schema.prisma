  acquisitionCost       Float?
  operatingCost         Float?
  maintenanceCost       Float?
  disposalCost          Float?
  replacementDate       DateTime?
  replacementReason     String?
  healthTrajectory      Json?    // array of {month, healthIndex}
  monthlyCostForecast   Json?    // array of {month, predictedCost}
  recommendedAction     String?  // continue_maintenance, repair, replace, upgrade
  confidence            Float?   // 0-1
  createdById           String
  createdAt             DateTime @default(now())

