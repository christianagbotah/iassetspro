  minimumThickness      Float?
  status                String   @default("active") // active, closed, superseded
  notes                 String?  @db.Text
  assessedById          String
  approvedById          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([assetId])
  @@index([riskCategory])
  @@index([status])
  @@map("rbi_assessments")
}

model SilAssessment {
  id                      String   @id @default(cuid())
  assetId                 String
  sifName                 String
  sifDescription          String?  @db.Text
  silTarget               Int      // 1, 2, 3, or 4
  silAchieved             Int?
  pfdRequired             Float?   // e.g. 0.01 for SIL 1
