  status        String   @default("pending") // pending, processed, dead_letter
  processedAt   DateTime?
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([eventType])
  @@index([correlationId])
  @@index([status])
  @@index([createdAt])
  @@index([entityName, entityId])
  @@index([eventType, createdAt])
  @@map("domain_events")
}

