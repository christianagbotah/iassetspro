  value           Float    @default(0)
  unit            String   @default("hours") // hours, cycles, starts, minutes
  lastResetAt     DateTime?
  isRunning       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  component ComponentRegistry @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([componentId, counterType])
  @@index([componentId])
  @@index([counterType])
  @@map("component_runtime_counters")
}

model ComponentConditionReading {
  id              String   @id @default(cuid())
  componentId     String
  parameterKey    String   // vibration, temperature, pressure, current, voltage, flow_rate, noise_level
  value           Float
  unit            String   // mm/s, °C, bar, A, V, m³/h, dB
  quality         Int      @default(100) // 0-100 data quality indicator
  minThreshold    Float?   // alarm low
