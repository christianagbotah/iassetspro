model EngineeringDocument {
  id                String   @id @default(cuid())
  documentNumber    String   @unique // auto-generated, e.g. "PID-MEC-001-REV-A"
  title             String
  description       String?  @db.Text
  category          String   // p_id, pfd, isometric, electrical, instrumentation, mechanical, civil, safety, quality, procedure, manual, specification
  subcategory       String?
  discipline        String?  // mechanical, electrical, instrument, civil, process, piping
  plantId           String?
  area              String?
  folderPath        String?  // virtual folder hierarchy
  status            String   @default("draft") // draft, under_review, approved, issued, superseded, obsolete
  version           Int      @default(1)
  revision          String   @default("A") // A, B, C, ...
  fileSize          Int?
  fileMimeType      String?
  fileUrl           String?  // storage URL
  thumbnailUrl      String?
  extractedText     String?  @db.Text // OCR/text extraction result
  metadata          Json?    // extracted metadata (title block, equipment list, etc.)
  tags              Json?    // auto-generated or manual tags
