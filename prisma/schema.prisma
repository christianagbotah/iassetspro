  proofTestIntervalMonths Int      @default(12)
  demandRate              Float?   // demands per year
  meanTimeToFailSpurious  Float?   // MTTF spurious (years)
  lopaLayers              Json?    // IPLs considered
  components              Json?    // SIS components with failure rates
  status                  String   @default("active") // draft, active, approved, archived
  assessedById            String
  approvedById            String?
  notes                   String?  @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([assetId])
  @@index([silTarget])
  @@index([status])
  @@map("sil_assessments")
}

model DegradationProfile {
  id                    String   @id @default(cuid())
  assetId               String
  parameterName         String   // e.g. "Vibration", "Temperature", "Pressure"
  unit                  String?
