  performedBy User             @relation("MaintenancePerformed", fields: [performedById], references: [id])

  @@index([componentId])
  @@index([workOrderId])
  @@index([maintenanceType])
  @@index([performedById])
  @@index([completedAt])
  @@map("component_maintenance_history")
}

model ComponentInspectionPoint {
