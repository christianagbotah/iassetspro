model FailureRecord {
  id              String   @id @default(cuid())
  componentId     String
  assetId         String?
  workOrderId     String?

  failureCode     String?  // standardized failure code
  failureMode     String   // mechanical, electrical, hydraulic, pneumatic, software, corrosion, fatigue, wear, other
  failureModeId   String?
  failureCause    String?  @db.Text
  failureSeverity String   @default("medium") // low, medium, high, critical
  symptoms        String?  @db.Text // JSON array of observed symptoms

  detectedAt      DateTime @default(now())
  resolvedAt      DateTime?
  downtimeMinutes Int      @default(0)
