  connections   String    @db.Text // JSON text of connections .Text
  specification String?   @db.Text // JSON text of specs
  healthScore   Int       @default(0) // 0-100
  syncInterval  String    @default("5min") // real_time, 1min, 5min, 15min
  lastSynced    DateTime?
  isActive      Boolean   @default(true)
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  asset     Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy User               @relation("DigitalTwinCreatedBy", fields: [createdById], references: [id])
  scenes    DigitalTwinScene[]
  componentRegistry ComponentRegistry[] @relation("RegistryTwin")
  tours     InspectionTour[]

  @@index([assetId])
  @@index([createdById])
  @@index([isActive])
  @@map("digital_twins")
}

// ============================================================================
// 25.5 DIGITAL TWIN SPATIAL & VISUALIZATION
// ============================================================================

model AssetModel {
  id           String   @id @default(cuid())
  assetId      String // → Asset
  name         String // model display name
  fileName     String // file name on disk
  filePath     String // relative path
  fileType     String // glb, gltf, fbx, obj, step
  fileSize     Int // bytes
  format       String   @default("glb") // glb, gltf
  boundingBox  String?  @db.Text // JSON: {minX, minY, minZ, maxX, maxY, maxZ}
  meshCount    Int      @default(0)
  vertexCount  Int      @default(0)
  thumbnailUrl String? // preview image
  uploadedById String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  asset      Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy User               @relation("AssetModelUploadedBy", fields: [uploadedById], references: [id])
  bindings   AssetMeshBinding[]
  scenes     DigitalTwinScene[]
  versions   ModelVersion[]     @relation("ModelVersions")

  @@index([assetId])
  @@index([uploadedById])
  @@map("asset_models")
}

model AssetMeshBinding {
  id            String   @id @default(cuid())
  modelId       String // → AssetModel
  assetId       String // → Asset (component asset)
  meshName      String // name of the mesh in the 3D model
  meshPath      String? // path in scene graph (e.g. "Pump/Motor/Rotor")
  meshType      String   @default("component") // component, assembly, subassembly, auxiliary
  isClickable   Boolean  @default(true)
  isVisible     Boolean  @default(true)
  colorOverride String? // hex color to override mesh material
  opacity       Float? // 0.0 to 1.0
  explodeOffset String?  @db.Text // JSON: {x, y, z} for exploded view offset
  metadata      String?  @db.Text // JSON for extra properties
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  model    AssetModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  asset    Asset         @relation("MeshBoundAsset", fields: [assetId], references: [id])
  hotspots TwinHotspot[]

  @@unique([modelId, meshName])
  @@index([modelId])
  @@index([assetId])
  @@map("asset_mesh_bindings")
}

model DigitalTwinScene {
  id                    String   @id @default(cuid())
  twinId                String // → DigitalTwin
  modelId               String // → AssetModel
  name                  String
  description           String?
  sceneType             String   @default("3d") // 3d, floor_plan, schematic
  environment           String   @default("warehouse") // warehouse, outdoor, clean_room, industrial
  backgroundColor       String   @default("#1a1a2e")
  groundPlane           Boolean  @default(true)
  gridEnabled           Boolean  @default(true)
  ambientLight          Float    @default(0.6)
  directionalLight      Float    @default(0.8)
  defaultCameraPosition String?  @db.Text // JSON: {x, y, z}
  defaultCameraTarget   String?  @db.Text // JSON: {x, y, z}
  isActive              Boolean  @default(true)
  createdById           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  twin          DigitalTwin        @relation(fields: [twinId], references: [id], onDelete: Cascade)
  model         AssetModel         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modelFile     ModelLibrary?      @relation(fields: [modelFileId], references: [id])
  modelFileId   String?
  createdBy     User               @relation("SceneCreatedBy", fields: [createdById], references: [id])
  hotspots      TwinHotspot[]
  annotations   TwinAnnotation[]
  cameraPresets TwinCameraPreset[]
  bookmarks     AssetViewBookmark[]

  @@index([twinId])
  @@index([modelId])
  @@index([createdById])
  @@index([modelFileId])
  @@map("digital_twin_scenes")
}

model TwinHotspot {
  id              String   @id @default(cuid())
  sceneId         String // → DigitalTwinScene
  bindingId       String? // → AssetMeshBinding (optional)
  assetId         String? // → Asset (linked asset for data)
  label           String
  description     String?
  position        String   @db.Text // JSON: {x, y, z}
  icon            String   @default("info") // info, warning, danger, maintenance, sensor
  color           String   @default("#3b82f6")
  isAlwaysVisible Boolean  @default(false)
  isPulsing       Boolean  @default(false)
  dataPoint       String? // iot device code, kpi metric, etc.
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  scene   DigitalTwinScene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  binding AssetMeshBinding? @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  asset   Asset?            @relation("HotspotAsset", fields: [assetId], references: [id])

  @@index([sceneId])
  @@index([assetId])
  @@index([bindingId])
  @@map("twin_hotspots")
}

model TwinCameraPreset {
  id                 String   @id @default(cuid())
  sceneId            String // → DigitalTwinScene
  name               String
  description        String?
  position           String   @db.Text // JSON: {x, y, z}
  target             String   @db.Text // JSON: {x, y, z}
  fov                Float    @default(50)
  transitionDuration Float    @default(1.0) // seconds for camera animation
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  scene DigitalTwinScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
  @@map("twin_camera_presets")
}

model TwinAnnotation {
  id        String   @id @default(cuid())
  sceneId   String // → DigitalTwinScene
  assetId   String? // → Asset
  title     String
  content   String   @db.Text
  authorId  String
  type      String   @default("note") // note, warning, maintenance_log, inspection
  priority  String   @default("low") // low, medium, high, critical
  color     String   @default("#fbbf24")
  position  String   @db.Text // JSON: {x, y, z}
  isPinned  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scene  DigitalTwinScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  author User             @relation(fields: [authorId], references: [id])

  @@index([sceneId])
  @@index([authorId])
  @@index([assetId])
  @@map("twin_annotations")
}

model SystemDiagram {
  id           String   @id @default(cuid())
  plantId      String?
  assetId      String?
  name         String
  description  String?
  type         String   @default("process") // piping, electrical, process, hvac, control, safety
  nodes        String   @db.Text // JSON array of nodes
  edges        String   @db.Text // JSON array of edges
  viewport     String?  @db.Text // JSON: {x, y, zoom}
  thumbnailUrl String?
  version      Int      @default(1)
  isTemplate   Boolean  @default(false)
  updatedById  String?
  isActive     Boolean  @default(true)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  asset               Asset?               @relation(fields: [assetId], references: [id])
  createdByIdUser User @relation("SystemDiagramCreatedBy", fields: [createdById], references: [id])
  updatedByIdUser User? @relation("SystemDiagramUpdatedBy", fields: [updatedById], references: [id])

  @@index([plantId])
  @@index([assetId])
  @@index([createdById])
  @@index([type])
  @@map("system_diagrams")
}

// ============================================================================
// CHAT / MESSAGING
// ============================================================================

model Conversation {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("direct") // direct, group
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@map("conversations")
}

model ConversationParticipant {
  id         String    @id @default(cuid())
  userId     String
  convoId    String    @map("conversationId")
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  convo Conversation @relation(fields: [convoId], references: [id], onDelete: Cascade)

  @@unique([userId, convoId])
  @@map("conversation_participants")
}

// ============================================================================
// SESSION MANAGEMENT
// ============================================================================

model Session {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  roles       String   @db.Text // JSON array of role slugs .Text
  permissions String   @db.Text // JSON array of permission slugs .Text
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastSeen    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ChatMessage {
  id          String   @id @default(cuid())
  convoId     String   @map("conversationId")
  senderId    String
  content     String
  messageType String   @default("text") // text, system
  createdAt   DateTime @default(now())

  convo  Conversation @relation(fields: [convoId], references: [id], onDelete: Cascade)
  sender User         @relation(fields: [senderId], references: [id])

  @@map("chat_messages")
}

// ============================================================================
// REPAIRS MODULE — Work Order Management Extensions
// ============================================================================

model RepairMaterialRequest {
  id                          String    @id @default(cuid())
  workOrderId                 String
  componentRegistryId         String? // → ComponentRegistry (which component needed this material)
  itemId                      String? // → InventoryItem
  itemName                    String
  quantityRequested           Float
  quantityApproved            Float     @default(0)
  quantityIssued              Float     @default(0)
  quantityReturned            Float     @default(0)
  unit                        String    @default("each")
  unitCost                    Float?
  estimatedCost               Float     @default(0)
  urgency                     String    @default("normal") // low, normal, high, critical
  reason                      String
  notes                       String?
  plantId                     String?
  source                      String    @default("technician") // planner_suggested, technician, template
  status                      String    @default("pending") // pending, supervisor_approved, store_approved, picking, issued, returned, closed, rejected
  supervisorApprovedQuantity  Float? // qty approved by supervisor (may differ from requested)
  storekeeperApprovedQuantity Float? // qty approved by storekeeper (may differ from supervisor qty)
  stockReserved               Boolean   @default(false) // whether stock was reserved at storekeeper approval
  requestedById               String // → User
  supervisorApprovedById      String?
  supervisorApprovedAt        DateTime?
  storekeeperApprovedById     String?
  storekeeperApprovedAt       DateTime?
  issuedById                  String? // → User
  issuedAt                    DateTime?
  returnedById                String? // → User
  returnedAt                  DateTime?
  consumedQty                 Float? // authoritative amount consumed after store reconciliation
  wastedQty                   Float? // authoritative amount wasted/discarded after store reconciliation
  declaredConsumedQty         Float? // technician-declared amount used before store verification
  declaredWastedQty           Float? // technician-declared amount wasted/damaged before store verification
  declaredReturnQty           Float? // technician-declared amount expected back to store
  usageDeclarationNotes       String?   @db.Text
  usageDeclaredById           String? // user who submitted the usage declaration
  usageDeclaredAt             DateTime?
  pickedAt                    DateTime? // when store picked the items
  pickedBy                    String? // who picked the items
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  // WorkOrder relation
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  // ComponentRegistry relation (which component needed this material)
  componentRegistry ComponentRegistry? @relation("RepairMatReqComponent", fields: [componentRegistryId], references: [id])

  // InventoryItem relation
  item InventoryItem? @relation(fields: [itemId], references: [id])

  // User relations
  requestedBy           User  @relation("RepairMatReqRequested", fields: [requestedById], references: [id])
  supervisorApprovedBy  User? @relation("RepairMatReqSupApproved", fields: [supervisorApprovedById], references: [id])
  storekeeperApprovedBy User? @relation("RepairMatReqStoreApproved", fields: [storekeeperApprovedById], references: [id])
  issuedByUser          User? @relation("RepairMatReqIssued", fields: [issuedById], references: [id])
  returnedByUser        User? @relation("RepairMatReqReturned", fields: [returnedById], references: [id])

  // Spare Part Return relations
  sparePartReturns    SparePartReturn[]   @relation("SparePartReturnMatReq")
  installedSpareParts InstalledSparePart[] @relation("InstalledSpareMaterialRequest")

  @@index([componentRegistryId])
  @@map("repair_material_requests")
}

// 2. RepairToolRequest — Tool requests from technicians
model RepairToolRequest {
  id                      String    @id @default(cuid())
  requestNumber           String?   @unique // format TR-YYYYMM-NNNN (nullable for backward compat with existing rows)
  workOrderId             String
  toolId                  String? // → Tool
  toolName                String
  reason                  String
  notes                   String?
  plantId                 String?
  source                  String    @default("technician") // planner_suggested, technician
  status                  String    @default("pending") // pending, supervisor_approved, storekeeper_approved, issued, returned, rejected
  urgency                 String    @default("normal") // low, normal, high, critical
  rejectionReason         String?
  toolConditionAtIssue    String? // new, good, fair, poor — captured at issue time
  toolConditionAtReturn   String? // new, good, fair, poor — captured at return time
  requestedById           String // → User
  supervisorApprovedById  String?
  supervisorApprovedAt    DateTime?
  storekeeperApprovedById String?
  storekeeperApprovedAt   DateTime?
  issuedById              String? // → User
  issuedAt                DateTime?
  returnedById            String? // → User (technician who submitted return)
  returnedAt              DateTime?
  returnConfirmedById     String? // → User (store keeper who confirmed)
  returnConfirmedAt       DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // WorkOrder relation
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  // Tool relation
  tool Tool? @relation(fields: [toolId], references: [id])

  // Line items (multi-tool support)
  items RepairToolRequestItem[]

  // User relations
  requestedBy           User  @relation("RepairToolReqRequested", fields: [requestedById], references: [id])
  supervisorApprovedBy  User? @relation("RepairToolReqSupApproved", fields: [supervisorApprovedById], references: [id])
  storekeeperApprovedBy User? @relation("RepairToolReqStoreApproved", fields: [storekeeperApprovedById], references: [id])
  issuedByUser          User? @relation("RepairToolReqIssued", fields: [issuedById], references: [id])
  returnedByUser        User? @relation("RepairToolReqReturned", fields: [returnedById], references: [id])
  returnConfirmedByUser User? @relation("RepairToolReqReturnConfirmed", fields: [returnConfirmedById], references: [id])

  // Damaged Tool Report relations
  damagedToolReports DamagedToolReport[] @relation("DamagedToolReportToolReq")

  @@map("repair_tool_requests")
}

// 2b. RepairToolRequestItem — Line items for multi-tool requests
model RepairToolRequestItem {
  id                    String    @id @default(cuid())
  repairToolRequestId   String    // → RepairToolRequest (header)
  toolId                String?   // → Tool (nullable — may not have exact tool match)
  toolName              String
  toolCode              String?   // display only, from tool.toolCode
  category              String?   // display only, from tool.category
  quantityRequested     Int       @default(1)
  quantityApproved      Int?
  quantityIssued        Int       @default(0)
  quantityReturned      Int       @default(0)
  quantityTransferred   Int       @default(0)
  unitCost              Float?    // cost per unit at time of request
  availabilityStatus    String?   // available, limited, unavailable — set at issue time
  issueNotes            String?   // reason for partial issue or non-issue
  conditionAtIssue      String?   // condition of tool when issued
  conditionAtReturn     String?   // condition when returned (confirmed by store keeper)
  pendingReturnQty      Int?      // quantity awaiting store keeper confirmation
  pendingReturnCondition String?  // condition reported by technician (pending confirmation)
  pendingReturnNotes    String?   // technician notes about the return
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  repairToolRequest RepairToolRequest @relation(fields: [repairToolRequestId], references: [id], onDelete: Cascade)
  tool               Tool?             @relation("ToolReqItemTool", fields: [toolId], references: [id])

  @@index([repairToolRequestId])
  @@map("repair_tool_request_items")
}

// 3. ToolTransferRequest — Tool transfer between technicians
model ToolTransferRequest {
  id                      String    @id @default(cuid())
  toolId                  String // → Tool
  fromUserId              String // → User
  toUserId                String // → User
  reason                  String
  notes                   String?
  plantId                 String?
  status                  String    @default("pending") // pending, storekeeper_approved, awaiting_handover, transferred, rejected
  rejectionReason         String?
  toolConditionAtTransfer String? // new, good, fair, poor — captured at approval
  fromUserAcceptedAt      DateTime?
  toUserAcceptedAt        DateTime?
  requestedById           String // → User
  storekeeperApprovedById String?
  storekeeperApprovedAt   DateTime?
  transferredAt           DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Tool relation
  tool Tool @relation(fields: [toolId], references: [id])

  // User relations
  fromUser              User  @relation("ToolTransferFrom", fields: [fromUserId], references: [id])
  toUser                User  @relation("ToolTransferTo", fields: [toUserId], references: [id])
  requestedBy           User  @relation("ToolTransferRequested", fields: [requestedById], references: [id])
  storekeeperApprovedBy User? @relation("ToolTransferStoreApproved", fields: [storekeeperApprovedById], references: [id])

  @@map("tool_transfer_requests")
}

// 4. WorkOrderDowntime — Equipment downtime related to WOs
model WorkOrderDowntime {
  id              String    @id @default(cuid())
  workOrderId     String
  assetId         String? // → Asset
  assetName       String
  downtimeStart   DateTime
  downtimeEnd     DateTime?
  durationMinutes Float     @default(0)
  reason          String
  category        String    @default("unplanned") // planned, unplanned, partial
  impactLevel     String    @default("medium") // low, medium, high, critical
  productionLoss  Float?
  notes           String?
  plantId         String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // WorkOrder relation
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  // User relation
  createdBy User @relation("DowntimeCreatedBy", fields: [createdById], references: [id])

  @@map("wo_downtimes")
}

// 5. RepairCompletion — Completion record capturing all closure data
model RepairCompletion {
  id                     String    @id @default(cuid())
  workOrderId            String    @unique
  completionNotes        String?
  findings               String?   @db.Text
  rootCause              String?
  correctiveAction       String?   @db.Text
  materialsUsedSummary   String    @default("[]") @db.Text // JSON: [{itemId, name, qty, cost}]
  toolsUsedSummary       String    @default("[]") @db.Text // JSON: [{toolId, name}]
  totalLaborHours        Float     @default(0)
  totalMaterialCost      Float     @default(0)
  totalToolCost          Float     @default(0)
  totalDowntimeMinutes   Float     @default(0)
  supervisorReviewNotes  String?
  supervisorApprovedById String? // → User
  supervisorApprovedAt   DateTime?
  supervisorStatus       String    @default("pending_review") // pending_review, approved, rework_requested
  reworkReason           String?
  reworkCount            Int       @default(0)
  plannerClosedById      String? // → User
  plannerClosedAt        DateTime?
  plannerStatus          String    @default("pending_closure") // pending_closure, closed
  closureNotes           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // WorkOrder relation
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  // User relations
  supervisorApprovedBy User? @relation("RepairCompSupApproved", fields: [supervisorApprovedById], references: [id])
  plannerClosedBy      User? @relation("RepairCompPlannerClosed", fields: [plannerClosedById], references: [id])

  @@map("repair_completions")
}

// 6. SparePartReturn — Reusable parts returned from machine for refurbishment
model InstalledSparePart {
  id                String    @id @default(cuid())
  componentId       String
  inventoryItemId   String?
  materialRequestId String?
  workOrderId       String?
  partName          String
  partCode          String?
  serialNumber      String?
  lotNumber         String?
  quantity          Float     @default(1)
  sourceType        String    @default("manual") // material_request, commissioning, manual
  status            String    @default("installed") // installed, removed, returned_to_store, scrapped
  installedAt       DateTime  @default(now())
  installedById     String
  removedAt         DateTime?
  removedById       String?
  removalReason     String?
  conditionOnRemoval String?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  component       ComponentRegistry      @relation("InstalledSpareComponent", fields: [componentId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem?         @relation("InstalledSpareInventory", fields: [inventoryItemId], references: [id], onDelete: SetNull)
  materialRequest RepairMaterialRequest? @relation("InstalledSpareMaterialRequest", fields: [materialRequestId], references: [id], onDelete: SetNull)
  workOrder       WorkOrder?             @relation("InstalledSpareWorkOrder", fields: [workOrderId], references: [id], onDelete: SetNull)
  installedBy     User                   @relation("InstalledSpareInstalledBy", fields: [installedById], references: [id])
  removedBy       User?                  @relation("InstalledSpareRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  sparePartReturn SparePartReturn?       @relation("InstalledSpareReturn")

  @@index([componentId, status])
  @@index([inventoryItemId])
  @@index([materialRequestId])
  @@index([workOrderId])
  @@index([installedAt])
  @@map("installed_spare_parts")
}

model SparePartReturn {
  id                  String    @id @default(cuid())
  returnNumber        String    @unique // format SPR-YYYYMM-NNNN
  workOrderId         String    // → WorkOrder
  componentId         String?   // → ComponentRegistry
  materialRequestId   String?   // → RepairMaterialRequest
  installedSparePartId String?   @unique // → InstalledSparePart physical identity
  itemId              String?   // → InventoryItem
  itemName            String
  partSerialNumber    String?
  quantity            Float     @default(1)
  conditionOnReturn   String    @default("used") // new, good, fair, poor, damaged, worn
  damageDescription   String?   @db.Text // description of any damage/wear
  refurbishmentNeeded Boolean   @default(false)
  refurbishmentNotes  String?   @db.Text
  estimatedRefurbCost Float?
  actualRefurbCost    Float?    @default(0)
  status              String    @default("pending") // pending, inspected, refurbishing, refurbished, returned_to_store, disposed, rejected
  inspectedById       String?   // → User
  inspectedAt         DateTime?
  inspectionNotes     String?   @db.Text
  refurbisherId       String?   // → User (who performs refurbishment)
  refurbishmentStart  DateTime?
  refurbishmentEnd    DateTime?
  returnedToStoreById String?   // → User (storekeeper who accepts back)
  returnedToStoreAt   DateTime?
  disposedById        String?
  disposedAt          DateTime?
  disposalReason      String?
  plantId             String?
  requestedById       String    // → User (technician who returned the part)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workOrder       WorkOrder?             @relation(fields: [workOrderId], references: [id])
  component       ComponentRegistry?     @relation("SparePartReturnComponent", fields: [componentId], references: [id])
  materialRequest RepairMaterialRequest? @relation("SparePartReturnMatReq", fields: [materialRequestId], references: [id])
  installedSparePart InstalledSparePart? @relation("InstalledSpareReturn", fields: [installedSparePartId], references: [id], onDelete: SetNull)
  item            InventoryItem?         @relation("SparePartReturnItem", fields: [itemId], references: [id])
  requestedBy     User                   @relation("SparePartReturnRequested", fields: [requestedById], references: [id])
  inspectedBy     User?                  @relation("SparePartReturnInspected", fields: [inspectedById], references: [id])
  refurbisher     User?                  @relation("SparePartReturnRefurbished", fields: [refurbisherId], references: [id])
  returnedToStore User?                  @relation("SparePartReturnStored", fields: [returnedToStoreById], references: [id])
  disposedByUser  User?                  @relation("SparePartReturnDisposed", fields: [disposedById], references: [id])

  @@index([workOrderId])
  @@index([status])
  @@index([plantId])
  @@index([itemId])
  @@index([componentId])
  @@map("spare_part_returns")
}

// 7. DamagedToolReport — Structured damage reporting for tools
model DamagedToolReport {
  id              String   @id @default(cuid())
  reportNumber    String   @unique // format DTR-YYYYMM-NNNN
  toolId          String   // → Tool
  workOrderId     String?  // → WorkOrder
  toolRequestId   String?  // → RepairToolRequest
  damageType      String   // broken, worn, malfunctioning, missing_parts, cosmetic, other
  damageSeverity  String   @default("medium") // low, medium, high, critical
  damageDescription String  @db.Text
  damagePhotoUrls String   @default("[]") @db.Text // JSON array of photo URLs
  quantity         Int      @default(1) // physical damaged units represented by this report
  repairHeldQuantity Int    @default(0) // units currently held in Tool.repairQuantity for this report
  occurredAt      DateTime?
  reportedById    String   // → User
  technicianId    String?  // → User (technician responsible, if different)
  status          String   @default("reported") // reported, assessed, repair_quoted, repair_in_progress, repaired, written_off, replaced
  assessmentNotes String?  @db.Text
  estimatedRepairCost Float?
  actualRepairCost    Float?
  repairVendorId  String?
  repairVendorName String?
  repairStartedAt DateTime?
  repairCompletedAt DateTime?
  repairCompletedById String?
  qcAcceptedById String?
  qcAcceptedAt   DateTime?
  qcNotes        String?  @db.Text
  writtenOffById  String?
  writtenOffAt    DateTime?
  writeOffReason  String?
  replacedWithToolId String?
  plantId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tool              Tool?               @relation(fields: [toolId], references: [id])
  workOrder         WorkOrder?          @relation(fields: [workOrderId], references: [id])
  toolRequest       RepairToolRequest?  @relation("DamagedToolReportToolReq", fields: [toolRequestId], references: [id])
  reportedBy        User                @relation("DamagedToolReported", fields: [reportedById], references: [id])
  technician        User?               @relation("DamagedToolTechnician", fields: [technicianId], references: [id])
  repairCompletedBy User?               @relation("DamagedToolRepaired", fields: [repairCompletedById], references: [id])
  writtenOffBy      User?               @relation("DamagedToolWrittenOff", fields: [writtenOffById], references: [id])

  @@index([toolId])
  @@index([workOrderId])
  @@index([status])
  @@index([plantId])
  @@map("damaged_tool_reports")
}

