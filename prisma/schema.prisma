model ModelLibrary {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  originalFile    String   // original filename
  storedPath      String   // storage path (local or S3)
  fileSize        Int      // bytes
  mimeType        String   @default("model/gltf-binary")
  format          String   @default("glb") // glb, gltf, fbx, obj, step
  version         Int      @default(1)
  status          String   @default("processing") // processing, ready, failed, archived
  thumbnail       String?  // auto-generated thumbnail path
  boundingBox     String?  @db.Text // JSON: {minX, minY, minZ, maxX, maxY, maxZ}
  geometryStats   String?  @db.Text // JSON: {vertices, faces, meshes, materials, animations}
  dracoCompressed Boolean  @default(false)
  optimizedForWeb Boolean  @default(false)
  maxLodPolygons  Int?     // highest LOD polygon count
  metadata        String?  @db.Text // JSON: any additional model metadata
  processingLog   String?  @db.Text
  processingError String?  @db.Text
  assetId         String?
  plantId         String?
  uploadedById    String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asset      Asset?                  @relation("ModelAsset", fields: [assetId], references: [id])
  plant      Plant?                  @relation("ModelPlant", fields: [plantId], references: [id])
  uploadedBy User                    @relation("ModelUploadedBy", fields: [uploadedById], references: [id])
  scenes     DigitalTwinScene[]
  versions   ModelVersion[]
  meshComponentMappings MeshComponentMapping[]
  modelProcessingJobs  ModelProcessingJob[]

  @@index([assetId])
  @@index([plantId])
  @@index([uploadedById])
  @@index([status])
  @@index([format])
  @@map("model_library")
}

model MeshComponentMapping {
  id                String   @id @default(cuid())
  modelId           String
  meshName          String   // GLTF node/mesh name
  meshPath          String   // GLTF node path (e.g., "Root/Pump/Impeller")
  mappingType       String   // component, spare_part, sensor, inspection_point, lubrication_point, pm_schedule, tool_requirement, work_instruction
  targetId          String   // ID of the mapped entity
  targetName        String?  // display name
  color             String?  // hex color for highlighting (e.g., "#ff0000")
  opacity           Float    @default(1.0)
  isHighlighted     Boolean  @default(false)
  isVisible         Boolean  @default(true)
  metadata          String?  @db.Text // JSON: any additional mapping data
  sortOrder         Int      @default(0)
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  model      ModelLibrary   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdBy  User            @relation("MappingCreatedBy", fields: [createdById], references: [id])

  @@unique([modelId, meshName, mappingType, targetId])
  @@index([modelId])
  @@index([meshName])
  @@index([mappingType])
  @@index([targetId])
  @@map("mesh_component_mappings")
}

model InspectionTour {
  id              String   @id @default(cuid())
  twinId          String
  name            String
  description     String?  @db.Text
  steps           String   @db.Text // JSON: TourStep[] with camera positions, duration, narration
  estimatedTime   Int      @default(0) // seconds
  difficulty      String   @default("basic") // basic, intermediate, advanced
  isPublished     Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  twin       DigitalTwin  @relation(fields: [twinId], references: [id], onDelete: Cascade)
  createdBy  User          @relation("TourCreatedBy", fields: [createdById], references: [id])

  @@index([twinId])
  @@index([isPublished])
  @@map("inspection_tours")
}

model ModelProcessingJob {
  id              String   @id @default(cuid())
  modelId         String
  jobType         String   // validation, thumbnail, draco_compress, optimize, lod_generation, metadata_extraction
  status          String   @default("queued") // queued, running, completed, failed
  input           String?  @db.Text // JSON: job parameters
  output          String?  @db.Text // JSON: job results
  error           String?  @db.Text
  progress        Int      @default(0) // 0-100
  startedAt       DateTime?
  completedAt     DateTime?
  duration        Int?     // milliseconds
  queuedById      String
  createdAt       DateTime @default(now())

  model     ModelLibrary @relation(fields: [modelId], references: [id], onDelete: Cascade)
  queuedBy  User         @relation("JobQueuedBy", fields: [queuedById], references: [id])

  @@index([modelId])
  @@index([status])
  @@index([jobType])
  @@map("model_processing_jobs")
}

model AssetViewBookmark {
  id              String   @id @default(cuid())
  sceneId         String
  name            String
  description     String?
  cameraPosition  String   @db.Text // JSON: {x, y, z}
  cameraTarget    String   @db.Text // JSON: {x, y, z}
  cameraUp        String?  @db.Text // JSON: {x, y, z}
  cameraFov       Float    @default(50)
  isOrthographic  Boolean  @default(false)
  zoomLevel       Float?   // for orthographic
  hiddenMeshes    String?  @db.Text // JSON: string[] of mesh paths to hide
  highlightedMeshes String? @db.Text // JSON: string[] of mesh paths to highlight
  sectionPlane    String?  @db.Text // JSON: {normal, constant}
  createdById     String
  createdAt       DateTime @default(now())

  scene     DigitalTwinScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  createdBy User              @relation("BookmarkCreatedBy", fields: [createdById], references: [id])

  @@index([sceneId])
  @@index([createdById])
  @@map("asset_view_bookmarks")
}

// ============================================================================
// ENGINEERING BOM & ASSEMBLY INTELLIGENCE (Phase B)
// ============================================================================

model BomRevision {
  id              String   @id @default(cuid())
  bomId           String
  revision        String   // e.g., "A", "B", "C", "1.0", "2.0"
  description     String?  @db.Text
  effectivityFrom DateTime?
  effectivityTo   DateTime?
  changeReason    String?  @db.Text // engineering change description
  status          String   @default("draft") // draft, pending_approval, approved, released, superseded, obsolete
  approvedById    String?
  approvedAt      DateTime?
  isActive        Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bom        BillOfMaterial        @relation(fields: [bomId], references: [id], onDelete: Cascade)
  approvedBy User?                 @relation("BomRevApprovedBy", fields: [approvedById], references: [id])
  createdBy  User                  @relation("BomRevCreatedBy", fields: [createdById], references: [id])
  items      BomRevisionItem[]

  @@index([bomId])
  @@index([status])
  @@index([isActive])
  @@map("bom_revisions")
}

model BomRevisionItem {
  id                String   @id @default(cuid())
  revisionId        String
  parentItemId      String?  // for hierarchical BOM (sub-assemblies)
  componentId       String?  // link to ComponentRegistry
  inventoryItemId   String?  // link to InventoryItem (spare part)
  itemNumber        String   // engineering part number
  itemName          String
  description       String?  @db.Text
  quantity          Float    @default(1)
  unitOfMeasure     String   @default("EA") // EA, KG, M, L, SET, etc.
  assemblySequence  Int?     // order in assembly
  relationshipType  String   @default("mechanical") // mechanical, electrical, hydraulic, pneumatic, process
  isCritical        Boolean  @default(false)
  leadTimeDays      Int?
  notes             String?  @db.Text

  revision     BomRevision          @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  parent       BomRevisionItem?     @relation("BomItemHierarchy", fields: [parentItemId], references: [id])
  children     BomRevisionItem[]    @relation("BomItemHierarchy")
  component    ComponentRegistry?   @relation("BomItemComponent", fields: [componentId], references: [id])
  inventory    InventoryItem?       @relation("BomItemInventory", fields: [inventoryItemId], references: [id])

  @@index([revisionId])
  @@index([parentItemId])
  @@index([componentId])
  @@index([inventoryItemId])
  @@map("bom_revision_items")
}

model AlternatePart {
  id                String   @id @default(cuid())
  primaryPartId     String   // ComponentRegistry ID
  alternatePartId   String   // ComponentRegistry ID
  interchangeability String @default("equivalent") // equivalent, superior, inferior, modified
  notes             String?  @db.Text
  approvedById      String?
  approvedAt        DateTime?
  isActive          Boolean  @default(true)
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  primaryPart   ComponentRegistry @relation("AltPrimaryPart", fields: [primaryPartId], references: [id], onDelete: Cascade)
  alternatePart ComponentRegistry @relation("AltAlternatePart", fields: [alternatePartId], references: [id], onDelete: Cascade)
  approvedBy     User?              @relation("AltPartApprovedBy", fields: [approvedById], references: [id])
  createdBy      User               @relation("AltPartCreatedBy", fields: [createdById], references: [id])

  @@unique([primaryPartId, alternatePartId])
  @@index([primaryPartId])
  @@index([alternatePartId])
  @@map("alternate_parts")
}

model EngineeringChangeRequest {
  id              String   @id @default(cuid())
  ecrNumber       String   @unique // ECR-YYYYMM-NNNN
  title           String
  description     String   @db.Text
  changeType      String   // addition, modification, deletion, substitution
  reason          String   @db.Text
  impact          String?  @db.Text // JSON: affected assemblies, cost impact, schedule impact
  priority        String   @default("medium") // low, medium, high, critical
  status          String   @default("draft") // draft, submitted, reviewing, approved, rejected, implemented, closed
  requestedById   String
  reviewedById    String?
  approvedById    String?
  reviewedAt      DateTime?
  approvedAt      DateTime?
  implementedAt   DateTime?
  bomId           String?
  assetId         String?
  plantId         String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bom         BillOfMaterial?      @relation(fields: [bomId], references: [id])
  asset       Asset?               @relation("EcrAsset", fields: [assetId], references: [id])
  plant       Plant?               @relation("EcrPlant", fields: [plantId], references: [id])
  requestedBy User                 @relation("EcrRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?                @relation("EcrReviewedBy", fields: [reviewedById], references: [id])
  approvedBy  User?                @relation("EcrApprovedBy", fields: [approvedById], references: [id])
  createdBy  User                 @relation("EcrCreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@index([bomId])
  @@index([assetId])
  @@index([plantId])
  @@index([requestedById])
  @@map("engineering_change_requests")
}

model CriticalSpareAnalysis {
  id                String   @id @default(cuid())
  componentId       String
  criticalityScore  Float    @default(0) // 0-100
  leadTimeRisk      String   @default("low") // low, medium, high, critical
  stockoutRisk      String   @default("low")
  recommendedStock  Int?
  currentStock      Int      @default(0)
  annualUsage       Float    @default(0)
  unitCost          Float?
  stockValue        Float?
  lastAnalysisDate  DateTime @default(now())
  notes             String?  @db.Text
  analyzedById      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  component   ComponentRegistry @relation(fields: [componentId], references: [id], onDelete: Cascade)
  analyzedBy  User               @relation("SpareAnalyzedBy", fields: [analyzedById], references: [id])

  @@unique([componentId])
  @@index([criticalityScore])
  @@index([leadTimeRisk])
  @@map("critical_spare_analysis")
}

// ============================================================================
// REAL-TIME INDUSTRIAL TELEMETRY (Phase C)
// ============================================================================

model TelemetryDataSource {
  id                String   @id @default(cuid())
  name              String
  sourceType        String   // mqtt, opcua, modbus_tcp, rest_api, siemens_s7, bacnet
  connectionConfig  String   @db.Text // JSON: host, port, path, credentials, topic patterns
  status            String   @default("disconnected") // connected, disconnected, error
  plantId           String?
  lastConnectionAt  DateTime?
  lastError         String?  @db.Text
  metadata          String?  @db.Text // JSON: any additional config
  createdById       String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  plant      Plant?       @relation("TelemetryPlant", fields: [plantId], references: [id])
  createdBy  User         @relation("TelemetrySourceCreatedBy", fields: [createdById], references: [id])
  mappings   TelemetryMapping[]
  streams    TelemetryStream[]

  // Industrial Connectivity (Phase 1)
  gatewayId  String?
  gateway    EdgeGateway? @relation("GatewaySource", fields: [gatewayId], references: [id], onDelete: SetNull)
  sessions   ConnectivitySession[]

  @@index([sourceType])
  @@index([status])
  @@index([plantId])
  @@map("telemetry_data_sources")
}

model TelemetryMapping {
  id              String   @id @default(cuid())
  sourceId        String
  deviceId        String?  // link to IotDevice
  externalId      String   // external tag/point ID from the source system
  parameterName   String   // e.g., "Temperature", "Pressure", "Vibration"
  parameterUnit   String?  // e.g., "°C", "bar", "mm/s"
  dataType        String   @default("float") // float, int, boolean, string
  scaleFactor     Float    @default(1)
  offset          Float    @default(0)
  deadband        Float?   // minimum change threshold to record
  qualityRule     String?  @db.Text // JSON: range limits, rate of change limits
  isActve         Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  source  TelemetryDataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  device  IotDevice?          @relation(fields: [deviceId], references: [id])

  streams       TelemetryStream[]
  aggregations  TelemetryAggregation[]
  alarmRules    AlarmRule[]
  alarmEvents   AlarmEvent[]

  @@unique([sourceId, externalId])
  @@index([sourceId])
  @@index([deviceId])
  @@index([parameterName])
  @@map("telemetry_mappings")
}

model TelemetryStream {
  id              String   @id @default(cuid())
  mappingId       String
  sourceId        String
  value           Float
  quality         Int      @default(100) // 0-100 quality score
  timestamp       DateTime @default(now())
  isAnomaly       Boolean  @default(false)
  anomalyScore    Float?
  metadata        String?  @db.Text // JSON: any additional data

  mapping TelemetryMapping    @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  source  TelemetryDataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([mappingId])
  @@index([sourceId])
  @@index([timestamp])
  @@index([sourceId, timestamp])
  @@index([isAnomaly])
  @@map("telemetry_streams")
}

model TelemetryAggregation {
  id              String   @id @default(cuid())
  mappingId       String
  periodType      String   // minute, hour, day, week, month
  periodStart     DateTime
  periodEnd       DateTime
  avgValue        Float?
  minValue        Float?
  maxValue        Float?
  sumValue        Float?
  count           Int
  stdDev          Float?

  mapping TelemetryMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@unique([mappingId, periodType, periodStart])
  @@index([mappingId])
  @@index([periodType])
  @@index([periodStart])
  @@map("telemetry_aggregations")
}

model AlarmRule {
  id              String   @id @default(cuid())
  name            String
  mappingId       String
  condition       String   @db.Text // JSON: {operator, threshold, duration, severity}
  severity        String   @default("warning") // info, warning, critical
  isActive        Boolean  @default(true)
  cooldownMinutes Int      @default(5)
  escalationPath  String?  @db.Text // JSON: escalation steps
  notification    String?  @db.Text // JSON: who to notify
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mapping   TelemetryMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  createdBy User              @relation("AlarmRuleCreatedBy", fields: [createdById], references: [id])

  events  AlarmEvent[]

  @@index([mappingId])
  @@index([severity])
  @@index([isActive])
  @@map("alarm_rules")
}

model AlarmEvent {
  id                String   @id @default(cuid())
  ruleId            String
  mappingId         String
  value             Float
  threshold         Float
  severity          String
  status            String   @default("active") // active, acknowledged, resolved, suppressed
  acknowledgedById  String?
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  resolutionNote    String?  @db.Text
  createdAt         DateTime @default(now())

  rule           AlarmRule        @relation(fields: [ruleId], references: [id])
  mapping        TelemetryMapping @relation(fields: [mappingId], references: [id])
  acknowledgedBy User?            @relation("AlarmAcknowledgedBy", fields: [acknowledgedById], references: [id])

  @@index([ruleId])
  @@index([mappingId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@index([mappingId, severity, status])
  @@map("alarm_events")
}

// ============================================================================
// PHASE D — RELIABILITY ENGINEERING PLATFORM
// ============================================================================

model FailureMode {
  id              String   @id @default(cuid())
  name            String
  code            String?  @unique
  description     String?  @db.Text
  category        String
  severity        String   @default("medium")
  detectionMethod String?
  iso14224Code    String?
  isActive        Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User   @relation("FailureModeCreatedBy", fields: [createdById], references: [id])
  records   FailureRecord[] @relation("FailureRecordMode")

  @@index([category])
  @@index([severity])
  @@map("failure_modes")
}

model RcmAnalysis {
  id              String   @id @default(cuid())
  assetId         String
  name            String
  description     String?  @db.Text
  methodology     String   @default("full")
  status          String   @default("draft")
  analysisDate    DateTime?
  nextReviewDate  DateTime?
  resultSummary   String?  @db.Text
  riskMatrix      String?  @db.Text
  approvedById    String?
  approvedAt      DateTime?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asset       Asset  @relation(fields: [assetId], references: [id])
  approvedBy  User?  @relation("RcmApprovedBy", fields: [approvedById], references: [id])
  createdBy  User   @relation("RcmCreatedBy", fields: [createdById], references: [id])

  @@index([assetId])
  @@index([status])
  @@map("rcm_analyses")
}

model WeibullAnalysis {
  id              String   @id @default(cuid())
  componentId     String
  name            String
  description     String?  @db.Text
  shape           Float?
  scale           Float?
  location        Float?
  confidence      Float?
  sampleSize      Int      @default(0)
  failureCount    Int      @default(0)
  timeRange       String?  @db.Text
  resultSummary   String?  @db.Text
  dataPoints      String?  @db.Text
  analyzedAt      DateTime @default(now())
  analyzedById    String

  component ComponentRegistry @relation(fields: [componentId], references: [id], onDelete: Cascade)
  analyzedBy User              @relation("WeibullAnalyzedBy", fields: [analyzedById], references: [id])

  @@index([componentId])
  @@map("weibull_analyses")
}

model DowntimeAnalysis {
  id                String   @id @default(cuid())
  assetId           String
  periodStart       DateTime
  periodEnd         DateTime
  totalDowntime     Float
  plannedDowntime   Float
  unplannedDowntime Float
  downtimeCost      Float?
  mtbf              Float?
  mttr              Float?
  availability      Float?
  reliability       Float?
  notes             String?  @db.Text
  createdById       String
  createdAt         DateTime @default(now())

  asset     Asset  @relation(fields: [assetId], references: [id])
  createdBy User   @relation("DowntimeCreatedBy", fields: [createdById], references: [id])

  @@index([assetId])
  @@index([periodStart])
  @@map("downtime_analyses")
}

model RemainingUsefulLife {
  id              String   @id @default(cuid())
  componentId     String
  currentHealth   Float
  degradationRate Float
  estimatedRul    Float?
  confidenceScore Float
  lastUpdated     DateTime @default(now())
  analyzedById    String

  component ComponentRegistry @relation(fields: [componentId], references: [id], onDelete: Cascade)
  analyzedBy User              @relation("RulAnalyzedBy", fields: [analyzedById], references: [id])

  @@unique([componentId])
  @@index([estimatedRul])
  @@map("remaining_useful_life")
}

// ============================================================================
// PHASE J — TIME-SERIES DATA LAYER
// ============================================================================

model TelemetryReading {
  id        String   @id @default(cuid())
  sourceId  String
  value     Float
  quality   String   @default("good") // good, uncertain, bad
  timestamp DateTime @default(now())

  @@index([sourceId])
  @@index([timestamp])
  @@index([sourceId, timestamp])
  @@map("telemetry_readings")
}

// ============================================================================
// INDUSTRIAL CONNECTIVITY (Phase 1 — New Architecture)
// ============================================================================

model EdgeGateway {
  id                String   @id @default(cuid())
  name              String
  gatewayCode       String   @unique
  ipAddress         String?
  macAddress        String?
  firmwareVersion   String?
  protocolVersion   String?
  plantId           String?
  location          String?
  status            String   @default("offline") // online, offline, degraded, maintenance
  lastHeartbeatAt   DateTime?
  lastSyncAt        DateTime?
  bufferingEnabled  Boolean  @default(true)
  bufferSize        Int      @default(10000) // max readings to buffer offline
  batchSize         Int      @default(500) // readings per batch sync
  syncIntervalMs    Int      @default(5000) // sync interval in ms
  config            Json? // gateway-specific config (polling intervals, etc.)
  capabilities      Json? // JSON array of supported protocols
  metadata          Json?
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  plant       Plant?              @relation("GatewayPlant", fields: [plantId], references: [id])
  createdBy   User                @relation("GatewayCreatedBy", fields: [createdById], references: [id])
  sources     TelemetryDataSource[] @relation("GatewaySource")
  connections ConnectivitySession[]

  @@index([status])
  @@index([plantId])
  @@map("edge_gateways")
}

model ConnectivitySession {
  id            String   @id @default(cuid())
  sourceId      String   // → TelemetryDataSource
  gatewayId     String?  // → EdgeGateway (null = direct connection)
  protocol      String   // mqtt, opcua, modbus_tcp, bacnet, siemens_s7, ethernet_ip, rest_api
  status        String   @default("disconnected") // connecting, connected, disconnected, error
  connectedAt   DateTime?
  disconnectedAt DateTime?
  errorCount    Int      @default(0)
  lastError     String?  @db.Text
  bytesIn       BigInt   @default(0)
  bytesOut      BigInt   @default(0)
  messagesIn    Int      @default(0)
  messagesOut   Int      @default(0)
  metadata      Json?    // protocol-specific session data
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  source  TelemetryDataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  gateway EdgeGateway?        @relation(fields: [gatewayId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([status])
  @@index([gatewayId])
  @@map("connectivity_sessions")
}

model TelemetryBatch {
  id          String   @id @default(cuid())
  sourceId    String   // → TelemetryDataSource
  gatewayId   String?  // → EdgeGateway
  batchNumber Int
  status      String   @default("pending") // pending, processing, completed, failed
  readingCount Int     @default(0)
  startTime   DateTime
  endTime     DateTime
  processedAt DateTime?
  errorCount  Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([sourceId])
  @@index([status])
  @@index([gatewayId])
  @@map("telemetry_batches")
}

model EventStreamRecord {
  id          String   @id @default(cuid())
  eventType   String   // data_ingested, alarm_triggered, anomaly_detected, connection_changed, batch_processed, sync_completed
  sourceType  String?  // mqtt, opcua, modbus_tcp, etc.
  sourceId    String?
  entityId    String?  // related entity ID (mapping, alarm, source, etc.)
  severity    String   @default("info") // info, warning, error, critical
  payload     Json?    // event-specific data
  correlationId String? // for tracing event chains
  timestamp   DateTime @default(now())

  @@index([eventType])
  @@index([sourceId])
  @@index([severity])
  @@index([timestamp])
  @@map("event_stream_records")
}

// ============================================================================
// HISTORIAN & TIME-SERIES INTELLIGENCE (Phase 2)
// ============================================================================

model DownsamplingPolicy {
  id                    String   @id @default(cuid())
  sourceId              String?  // null = global default
  rawRetentionDays      Int      @default(7)
  minuteRetentionDays   Int      @default(30)
  hourlyRetentionDays   Int      @default(90)
  dailyRetentionDays    Int      @default(730)
  weeklyRetentionDays   Int      @default(3650)
  aggregationMethod     String   @default("avg") // avg, min, max, last, maxmin
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("downsampling_policies")
}

model DownsampledReading {
  id          String   @id @default(cuid())
  sourceId    String
  interval    String   // '1m', '5m', '1h', '1d', '1w'
  bucketStart DateTime
  avgValue    Float
  minValue    Float
  maxValue    Float
  sumValue    Float    @default(0)
  count       Int      @default(0)
  stdDev      Float?   @default(0)
  quality     Float?   @default(100) // average quality of source readings in bucket
  createdAt   DateTime @default(now())

  @@unique([sourceId, interval, bucketStart])
  @@index([sourceId, interval, bucketStart])
  @@index([sourceId, interval])
  @@map("downsampled_readings")
}

model RetentionPolicy {
  id              String   @id @default(cuid())
  name            String
  description     String?
  sourceId        String?
  keepDays        Int
  aggregationKeepDays Int? // keep downsampled data longer
  isActive        Boolean  @default(true)
  lastExecutedAt  DateTime?
  totalDeleted    Int      @default(0)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("retention_policies")
}

model AnomalyDetectionConfig {
  id                String   @id @default(cuid())
  sourceId          String?  // null = global
  mappingId         String?
  method            String   @default("zscore") // zscore, modified_zscore, iqr, ema, rate_of_change, pattern
  windowSize        Int      @default(30) // number of readings for baseline
  threshold         Float    @default(3) // standard deviations or IQR multiplier
  cooldownMinutes   Int      @default(15)
  confirmationCount Int      @default(2) // require N consecutive anomalies
  isActive          Boolean  @default(true)
  config            Json?    // method-specific params
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("anomaly_detection_configs")
}

model AnomalyRecord {
  id            String   @id @default(cuid())
  sourceId      String
  mappingId     String?
  detectedAt    DateTime @default(now())
  method        String
  value         Float
  expectedValue Float?
  anomalyScore  Float
  severity      String   @default("warning") // low, warning, high, critical
  confirmed     Boolean  @default(false)
  acknowledgedAt DateTime?
  acknowledgedById String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([sourceId, detectedAt])
  @@index([severity])
  @@index([confirmed])
  @@map("anomaly_records")
}

model DataQualityReport {
