model Attachment {
  id           String   @id @default(cuid())
  fileName     String
  fileType     String // MIME type
  fileSize     Int // bytes
  filePath     String // relative path on disk
  entityType   String // e.g. 'work_order', 'maintenance_request', 'asset', 'safety_incident'
  entityId     String
  uploadedById String
  uploadedAt   DateTime @default(now())
  description  String?

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@map("attachments")
}



model ComponentRegistry {
  id                String   @id @default(cuid())
  parentId          String?
  assetId           String?
  twinId            String?
  componentCode     String
  name              String
  description       String?  @db.Text
  componentType     String   @default("component") // assembly, subassembly, component, part, auxiliary, instrument
  manufacturer      String?
  modelNumber       String?
  serialNumber      String?  @unique
  specification     String?  @db.Text // JSON: full specs (power, speed, capacity, etc.)
  operatingParams   String?  @db.Text // JSON: normal operating parameters
  criticality       String   @default("medium") // low, medium, high, critical
  lifecycleStatus   String   @default("operational") // operational, degraded, failed, under_maintenance, decommissioned
  installedDate     DateTime?
  expectedLifeHours Float?
  operatingHours    Float    @default(0)
  lastInspection    DateTime?
  nextInspectionDue DateTime?
  healthScore       Int      @default(100) // 0-100 computed or manual
  sortOrder         Int      @default(0)
  notes             String?  @db.Text

  parent        ComponentRegistry?  @relation("ComponentHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      ComponentRegistry[] @relation("ComponentHierarchy")
  asset         Asset?               @relation("RegistryAsset", fields: [assetId], references: [id])
  twin          DigitalTwin?         @relation("RegistryTwin", fields: [twinId], references: [id])
  failureRecords FailureRecord[]
  sparePartLinks ComponentSparePart[]
  toolRequirements ComponentToolRequirement[]
  predictiveModels PredictiveModel[]
  predictionAlerts PredictionAlert[]

  // Component Maintenance Intelligence relations
  runtimeCounters          ComponentRuntimeCounter[]
  conditionReadings        ComponentConditionReading[]
  maintenanceHistory       ComponentMaintenanceHistory[]
  pmSchedules              PmSchedule[] @relation("PmScheduleComponent")
  inspectionPoints         ComponentInspectionPoint[]
  inspectionRecords        ComponentInspectionRecord[]
  lubricationSchedules     ComponentLubricationSchedule[]
  lubricationRecords       ComponentLubricationRecord[]
  replacementHistory       ComponentReplacementHistory[]
  installedSpareParts      InstalledSparePart[] @relation("InstalledSpareComponent")
  visuals                  ComponentVisual[]

  // Engineering BOM & Assembly Intelligence relations (Phase B)
  bomItems              BomRevisionItem[]    @relation("BomItemComponent")
  altPrimaryParts       AlternatePart[]      @relation("AltPrimaryPart")
  altAlternateParts     AlternatePart[]      @relation("AltAlternatePart")
  spareAnalysis         CriticalSpareAnalysis?
  weibullAnalyses        WeibullAnalysis[]
  rulEstimate            RemainingUsefulLife?

  // Work Order - Component tracking
  workOrderComponents     WorkOrderComponent[]
  repairMaterialRequests  RepairMaterialRequest[] @relation("RepairMatReqComponent")
  sparePartReturns        SparePartReturn[] @relation("SparePartReturnComponent")

  @@unique([componentCode])
  @@index([parentId])
  @@index([assetId])
  @@index([twinId])
  @@index([componentType])
  @@index([criticality])
  @@index([lifecycleStatus])
  @@map("component_registry")
}

model ComponentVisual {
  id             String   @id @default(cuid())
