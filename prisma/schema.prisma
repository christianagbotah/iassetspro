// ============================================================================
// ENTERPRISE WORKFLOW ORCHESTRATION (Phase 4)
// ============================================================================

model WorkflowDefinition {
  id              String   @id @default(cuid())
  name            String
  key             String   @unique // e.g. "work_order_approval", "permit_to_work"
  version         Int      @default(1)
  category        String?  // maintenance, procurement, safety, quality, engineering
  description     String?  @db.Text
  stepsJson       Json?    // array of step definitions
  transitionsJson Json?    // array of transition rules
  triggersJson    Json?    // event triggers
  variablesSchema Json?    // workflow variable schema
  isActive        Boolean  @default(false)
  isSystem        Boolean  @default(false) // cannot be deleted
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instances WorkflowInstance[]

  @@index([key])
  @@index([category])
  @@index([isActive])
  @@map("workflow_definitions")
}

model WorkflowInstance {
  id              String   @id @default(cuid())
  definitionId    String
  entityType      String?  // work_order, maintenance_request, safety_permit, etc.
  entityId        String?  // reference to the entity
  currentStepId   String?
  status          String   @default("pending") // pending, running, suspended, completed, cancelled, failed
  variables       Json?    // workflow context variables
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  startedById     String?
  completedById   String?
  cancelledById   String?
