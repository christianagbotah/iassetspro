model StoEvent {
  id                String   @id @default(cuid())
  stoNumber         String   @unique // STO-YYYYMM-NNNN
  name              String
  description       String?  @db.Text
  type              String   @default("turnaround") // planned_shutdown, turnaround, forced_outage, emergency
  plantId           String
  unitId            String?  // production unit or area
  status            String   @default("planning") // planning, scheduled, pre_shutdown, in_progress, startup, completed, cancelled
  plannedStartDate  DateTime?
  plannedEndDate    DateTime?
  actualStartDate   DateTime?
  actualEndDate     DateTime?
  estimatedDurationHours Float?
  actualDurationHours   Float?
  budgetAmount      Float?
  actualCost        Float    @default(0)
  scopeJson         Json?    // equipment and work packages
  milestonesJson    Json?    // milestone definitions
  riskAssessment    Json?
  notes             String?  @db.Text
  createdById       String
  approvedById      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tasks             StoTask[]
  contractors       StoContractorAssignment[]
  progressReports   StoProgressReport[]

  @@index([plantId])
  @@index([status])
  @@index([plannedStartDate])
  @@map("sto_events")
}

model StoTask {
  id              String   @id @default(cuid())
  eventId         String
  workOrderId     String?  // linked WO
  title           String
  description     String?  @db.Text
  discipline      String?  // mechanical, electrical, instrument, civil, safety
  priority        String   @default("medium")
  estimatedHours  Float?
  actualHours     Float?
  startDate       DateTime?
  endDate         DateTime?
  earlyStart      DateTime?
  earlyFinish     DateTime?
  lateStart       DateTime?
  lateFinish      DateTime?
  totalFloat      Float?   // hours
  freeFloat       Float?
  isOnCriticalPath Boolean  @default(false)
  status          String   @default("pending") // pending, in_progress, completed, cancelled
  progress        Float    @default(0) // 0-100%
  predecessorIds  Json?    // array of StoTask IDs
  successorIds    Json?    // array of StoTask IDs
  assignedToId    String?  // contractor or internal crew
  notes           String?  @db.Text
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           StoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([isOnCriticalPath])
  @@index([status])
  @@map("sto_tasks")
}

model StoContractor {
  id                String   @id @default(cuid())
  name              String
  code              String   @unique
  contactPerson     String?
  contactPhone      String?
  contactEmail      String?
  company           String?
  taxId             String?
  address           String?  @db.Text
  specialties       Json?    // array of disciplines
  qualificationLevel String? // tier1, tier2, tier3
  insuranceExpiry   DateTime?
  safetyCertExpiry  DateTime?
  rating            Float?   // 1-5
  isActive          Boolean  @default(true)
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assignments       StoContractorAssignment[]

  @@map("sto_contractors")
}

model StoContractorAssignment {
  id              String   @id @default(cuid())
  contractorId    String
  eventId         String
  taskIds         Json?    // array of StoTask IDs
  laborCount      Int?
  startDate       DateTime?
  endDate         DateTime?
  budgetAmount    Float?
  actualCost      Float?
  accessPermitId  String?
  status          String   @default("assigned") // assigned, mobilized, on_site, demobilized, completed
  performanceRating Float?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contractor      StoContractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  event           StoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([eventId])
  @@map("sto_contractor_assignments")
}

model StoProgressReport {
  id              String   @id @default(cuid())
  eventId         String
  reportDate      DateTime @default(now())
  overallProgress Float    @default(0) // 0-100%
  tasksCompleted  Int      @default(0)
  tasksTotal      Int      @default(0)
  tasksInProgress Int      @default(0)
  issuesCount     Int      @default(0)
  holdsCount      Int      @default(0)
  incidentsCount  Int      @default(0)
  manHoursToday   Float?
  manHoursTotal   Float?
  budgetSpent     Float?
  budgetRemaining Float?
  highlights      String?  @db.Text
  issues          Json?    // array of {description, severity, status}
  notes           String?  @db.Text
  reportedById    String
  createdAt       DateTime @default(now())

  event           StoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, reportDate])
  @@map("sto_progress_reports")
}

