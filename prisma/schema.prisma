generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// 1. CORE RBAC SYSTEM
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  level       Int      @default(0) // hierarchy level (higher = more privileges)
  isSystem    Boolean  @default(false) // cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  slug        String   @unique // e.g. "work_orders.view"
  name        String // e.g. "View Work Orders"
  module      String // e.g. "work_orders"
  action      String // view, create, update, delete, approve, assign, execute, export
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                      String    @id @default(cuid())
  username                String    @unique
  email                   String    @unique
  passwordHash            String
  fullName                String
  staffId                 String?   @unique
  phone                   String?
  avatar                  String?
  department              String?
  status                  String    @default("active") // active, inactive
  isVendorAdmin           Boolean   @default(false)
  resetToken              String?
  resetTokenExpires       DateTime?
  notificationPreferences Json? // notification preferences (channels, types, quiet hours)
  preferences             Json? // user display/notification/datetime preferences
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // RBAC relations
  userRoles   UserRole[]
  directPerms UserPermission[]
  plantAccess UserPlant[]

  // Department supervision
  deptSupervised Department[] @relation("DeptSupervisor")

  // Maintenance Request relations
  mrRequested  MaintenanceRequest[] @relation("MRRequester")
  mrSupervised MaintenanceRequest[] @relation("MRSupervisor")
  mrApproved   MaintenanceRequest[] @relation("MRApprover")
  mrPlanned    MaintenanceRequest[] @relation("MRPlanner")

  // Work Order relations
  woAssigned   WorkOrder[] @relation("WOAssignedTo")
  woTeamLeader WorkOrder[] @relation("WOTeamLeader")
  woSupervised WorkOrder[] @relation("WOSupervisor")
  woAssignedBy WorkOrder[] @relation("WOAssignedBy")
  woPlanned    WorkOrder[] @relation("WOPlanner")
  woLocked     WorkOrder[] @relation("WOLocker")

  // Work Order sub-table relations
  woTeamMembers              WorkOrderTeamMember[]
  woTeamMembersAdded         WorkOrderTeamMember[] @relation("TMAddedBy")
  woTeamMemberReqsRequested  WoTeamMemberRequest[] @relation("TMReqRequestedBy") // as requester
  woTeamMemberReqsAsTarget   WoTeamMemberRequest[] // as requested user (to be added)
  woTeamMemberReqsReviewed   WoTeamMemberRequest[] @relation("TMReqReviewedBy")
  woTimeLogs           WorkOrderTimeLog[]
  woComments           WorkOrderComment[]
  woMaterialsRequested WorkOrderMaterial[]   @relation("WOMatRequested")
  woMaterialsApproved  WorkOrderMaterial[]   @relation("WOMatApproved")
  woMaterialsIssued    WorkOrderMaterial[]   @relation("WOMatIssued")

  // Audit
  auditLogs     AuditLog[]
  notifications Notification[]

  // Asset Management relations
  assetsCreated         Asset[]                     @relation("AssetCreatedBy")
  assetsAssigned        Asset[]                     @relation("AssetAssignedTo")
  inventoryItemsCreated InventoryItem[]             @relation("InventoryItemCreatedBy")
  stockMovements        StockMovement[]
  pmSchedulesAssigned   PmSchedule[]                @relation("PmScheduleAssignedTo")
  pmSchedulesCreated    PmSchedule[]                @relation("PmScheduleCreatedBy")
  pmTemplatesCreated    PmTemplate[]                @relation("PmTemplateCreatedBy")
  woStatusHistory       WorkOrderStatusHistory[]
  mrComments            MaintenanceRequestComment[]

  // Tool Management relations
  toolsAssigned    Tool[]            @relation("ToolAssignedTo")
  toolsCreated     Tool[]            @relation("ToolCreatedBy")
  toolTransactions ToolTransaction[] @relation("ToolTxnPerformedBy")
  toolTxnsFrom     ToolTransaction[] @relation("ToolTxnFromUser")
  toolTxnsTo       ToolTransaction[] @relation("ToolTxnToUser")
  toolCalibrationsPerformed  ToolCalibrationRequirement[] @relation("ToolCalBy")
  toolCalibrationOverrides    ToolCalibrationRequirement[] @relation("ToolCalOverride")

  // IoT Management relations
  iotDevicesCreated IotDevice[]    @relation("IotDeviceCreatedBy")
  iotRulesCreated   IotAlertRule[] @relation("IotRuleCreatedBy")

  // Real-Time Industrial Telemetry relations (Phase C)
  telemetrySources     TelemetryDataSource[] @relation("TelemetrySourceCreatedBy")
  alarmRules           AlarmRule[]           @relation("AlarmRuleCreatedBy")
  alarmsAcknowledged   AlarmEvent[]          @relation("AlarmAcknowledgedBy")

  // Inventory Sub-module relations
  invLocationsCreated    InventoryLocation[]   @relation("InvLocationCreatedBy")
  invAdjustmentsApproved InventoryAdjustment[] @relation("InvAdjApprovedBy")
  invAdjustmentsCreated  InventoryAdjustment[] @relation("InvAdjCreatedBy")
  invRequestsRequested   InventoryRequest[]    @relation("InvReqRequestedBy")
  invRequestsApproved    InventoryRequest[]    @relation("InvReqApprovedBy")
  invTransfersRequested  InventoryTransfer[]   @relation("InvTransferRequestedBy")
  invTransfersApproved   InventoryTransfer[]   @relation("InvTransferApprovedBy")
  suppliersCreated       Supplier[]            @relation("SupplierCreatedBy")
  poCreated              PurchaseOrder[]       @relation("POCreatedBy")
  poApproved             PurchaseOrder[]       @relation("POApprovedBy")
  receivingReceived      ReceivingRecord[]     @relation("ReceivingReceivedBy")
  receivingDispositioned ReceivingRecord[]     @relation("ReceivingDispositionedBy")

  // Safety Module relations
  safetyIncidentsReported     SafetyIncident[] @relation("SafetyIncidentReportedBy")
  safetyIncidentsInvestigated SafetyIncident[] @relation("SafetyIncidentInvestigatedBy")
  safetyPermitsRequested      SafetyPermit[]   @relation("SafetyPermitRequestedBy")
  safetyPermitsApproved       SafetyPermit[]   @relation("SafetyPermitApprovedBy")

  // Quality Module relations
  qualityInspections  QualityInspection[]    @relation("QIInspectedBy")
  ncrs                NonConformanceReport[] @relation("NCRRaisedBy")
  qualityAudits       QualityAudit[]         @relation("QAuditedBy")
  spcProcessesCreated SpcProcess[]           @relation("SpcProcessCreatedBy")

  // Digital Twin relation
  digitalTwinsCreated   DigitalTwin[]      @relation("DigitalTwinCreatedBy")
  assetModelsCreated    AssetModel[]       @relation("AssetModelUploadedBy")
  scenesCreated         DigitalTwinScene[] @relation("SceneCreatedBy")
  systemDiagramsCreated SystemDiagram[]    @relation("SystemDiagramCreatedBy")
  SystemDiagramUpdates SystemDiagram[] @relation("SystemDiagramUpdatedBy")

  // Twin Annotation relation
  twinAnnotations TwinAnnotation[]

  // Operations Module relations
  meterReadings      MeterReading[]  @relation("MeterReadingReadBy")
  shiftHandoversFrom ShiftHandover[] @relation("ShiftHandoverFrom")
  shiftHandoversTo   ShiftHandover[] @relation("ShiftHandoverTo")

  // Chat relations
  chatMessages             ChatMessage[]
  conversationParticipants ConversationParticipant[]

  // Session Management
  sessions Session[]

  // Trade / Skill relations
  primaryTrade String?
  userSkills   UserSkill[]

  // Labor Rate relation
  laborRates             LaborRate[] @relation("UserLaborRate")

  // Repair module relations
  downtimeLogged      WorkOrderDowntime[]      @relation("DowntimeCreatedBy")
  repairMatReqRequested      RepairMaterialRequest[] @relation("RepairMatReqRequested")
  repairMatReqSupApproved    RepairMaterialRequest[] @relation("RepairMatReqSupApproved")
  repairMatReqStoreApproved  RepairMaterialRequest[] @relation("RepairMatReqStoreApproved")
  repairMatReqIssued         RepairMaterialRequest[] @relation("RepairMatReqIssued")
  repairMatReqReturned       RepairMaterialRequest[] @relation("RepairMatReqReturned")
  repairToolReqRequested     RepairToolRequest[]     @relation("RepairToolReqRequested")
  repairToolReqSupApproved   RepairToolRequest[]     @relation("RepairToolReqSupApproved")
  repairToolReqStoreApproved RepairToolRequest[]     @relation("RepairToolReqStoreApproved")
  repairToolReqIssued        RepairToolRequest[]     @relation("RepairToolReqIssued")
  repairToolReqReturned      RepairToolRequest[]     @relation("RepairToolReqReturned")
  repairToolReqReturnConfirmed RepairToolRequest[] @relation("RepairToolReqReturnConfirmed")
  toolTransferFrom           ToolTransferRequest[]   @relation("ToolTransferFrom")
  toolTransferTo             ToolTransferRequest[]   @relation("ToolTransferTo")
  toolTransferRequested      ToolTransferRequest[]   @relation("ToolTransferRequested")
  toolTransferStoreApproved  ToolTransferRequest[]   @relation("ToolTransferStoreApproved")
  repairCompSupApproved      RepairCompletion[]      @relation("RepairCompSupApproved")
  repairCompPlannerClosed    RepairCompletion[]      @relation("RepairCompPlannerClosed")

  // Spare Part Return relations
  sparePartReturnsRequested  SparePartReturn[]       @relation("SparePartReturnRequested")
  sparePartReturnsInspected  SparePartReturn[]       @relation("SparePartReturnInspected")
  sparePartReturnsRefurbished SparePartReturn[]      @relation("SparePartReturnRefurbished")
  sparePartReturnsStored     SparePartReturn[]       @relation("SparePartReturnStored")
  sparePartReturnsDisposed   SparePartReturn[]       @relation("SparePartReturnDisposed")

  // Damaged Tool Report relations
  damagedToolReportsFiled    DamagedToolReport[]     @relation("DamagedToolReported")
  damagedToolReportsAsTech   DamagedToolReport[]     @relation("DamagedToolTechnician")
  damagedToolReportsRepaired DamagedToolReport[]     @relation("DamagedToolRepaired")
  damagedToolReportsWrittenOff DamagedToolReport[]   @relation("DamagedToolWrittenOff")

  // Attachment relations
  attachments Attachment[]

  // Digital Twin Phase 1 relations
  twinAuditLogs       TwinAuditLog[]     @relation("TwinAuditUser")
  modelVersionUploads ModelVersion[]     @relation("ModelVersionUploaded")
  failureReports      FailureRecord[]    @relation("FailureReported")
  predictiveModels    PredictiveModel[]  @relation("PredictiveCreatedBy")
  predictionAcknowledged PredictionAlert[] @relation("PredictionAcknowledged")

  // Component Maintenance Intelligence relations
  conditionRecordings      ComponentConditionReading[]  @relation("ConditionRecorded")
  maintenancePerformed     ComponentMaintenanceHistory[] @relation("MaintenancePerformed")
  inspectionRecords        ComponentInspectionRecord[]   @relation("InspectionRecorded")
  lubricationPerformed     ComponentLubricationRecord[]  @relation("LubricationPerformed")
  replacementPerformed     ComponentReplacementHistory[] @relation("ReplacementPerformed")
  installedSpareParts      InstalledSparePart[]          @relation("InstalledSpareInstalledBy")
  removedSpareParts        InstalledSparePart[]          @relation("InstalledSpareRemovedBy")

  // Work Instruction relations
  workInstructionsCreated  WorkInstruction[]       @relation("WICreatedBy")

  // Work Order Task Execution relations
  woTasksCompleted WorkOrderTaskExecution[] @relation("TaskCompletedBy")

  // Time Log relations (team leader logging for members)
  timeLogsLoggedForOthers WorkOrderTimeLog[] @relation("TimeLogLoggedBy")

  // Enterprise Model Library relations (Phase A)
  uploadedModels  ModelLibrary[]          @relation("ModelUploadedBy")
  meshMappings    MeshComponentMapping[]  @relation("MappingCreatedBy")
  tours           InspectionTour[]        @relation("TourCreatedBy")
  bookmarks       AssetViewBookmark[]     @relation("BookmarkCreatedBy")
  processingJobs  ModelProcessingJob[]   @relation("JobQueuedBy")

  // Engineering BOM & Assembly Intelligence relations (Phase B)
  bomRevisionsApproved BomRevision[]        @relation("BomRevApprovedBy")
  bomRevisionsCreated  BomRevision[]        @relation("BomRevCreatedBy")
  altPartsApproved     AlternatePart[]      @relation("AltPartApprovedBy")
  altPartsCreated      AlternatePart[]      @relation("AltPartCreatedBy")
  spareAnalyses        CriticalSpareAnalysis[] @relation("SpareAnalyzedBy")
  ecrRequested         EngineeringChangeRequest[] @relation("EcrRequestedBy")
  ecrReviewed          EngineeringChangeRequest[] @relation("EcrReviewedBy")
  ecrApproved          EngineeringChangeRequest[] @relation("EcrApprovedBy")
  ecrCreated           EngineeringChangeRequest[] @relation("EcrCreatedBy")
  failureModesCreated FailureMode[]           @relation("FailureModeCreatedBy")
  rcmAnalysesApproved  RcmAnalysis[]            @relation("RcmApprovedBy")
  rcmAnalysesCreated   RcmAnalysis[]            @relation("RcmCreatedBy")
  weibullAnalyses       WeibullAnalysis[]        @relation("WeibullAnalyzedBy")
  downtimeAnalyses      DowntimeAnalysis[]       @relation("DowntimeCreatedBy")
  rulAnalyses           RemainingUsefulLife[]     @relation("RulAnalyzedBy")

  // Work Package relations
  wpCreated       WorkPackage[] @relation("WPCreatedBy")
  wpAssigned      WorkPackage[] @relation("WPAssignedTo")

  // Industrial Connectivity (Phase 1)
  gatewaysCreated EdgeGateway[] @relation("GatewayCreatedBy")

  @@map("users")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserPermission {
  id           String    @id @default(cuid())
  userId       String
  permissionId String
  isGranted    Boolean   @default(true)
  expiresAt    DateTime?
  grantedBy    String? // userId of the granter
  createdAt    DateTime  @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

// ============================================================================
// 2. MODULE SUBSCRIPTION SYSTEM (3-tier)
// ============================================================================

model SystemModule {
  id               String    @id @default(cuid())
  code             String    @unique
  name             String
  description      String?
  version          String    @default("1.0.0")
  isCore           Boolean   @default(false)
  isSystemLicensed Boolean   @default(false) // vendor-level license flag
  licenseKey       String?
  validFrom        DateTime?
  validUntil       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  companyModules CompanyModule[]

  @@map("system_modules")
}

model CompanyModule {
  id               String    @id @default(cuid())
  systemModuleId   String
  companyId        String? // tenant/company reference (optional for single-company setup)
  isActive         Boolean   @default(false) // licensed by vendor
  isEnabled        Boolean   @default(false) // activated by company
  licensedAt       DateTime?
  licensedBy       String?
  activatedAt      DateTime?
  activatedBy      String?
  activationLocked Boolean   @default(false) // prevent deactivation once locked
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  systemModule SystemModule @relation(fields: [systemModuleId], references: [id], onDelete: Cascade)

  @@unique([systemModuleId, companyId])
  @@map("company_modules")
}

// ============================================================================
// 3. PLANT / ORGANIZATION
// ============================================================================

model Plant {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  location  String?
  country   String?
  city      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments    Department[]
  plantAccess    UserPlant[]
  assets         Asset[]
  inventoryItems InventoryItem[]
  models         ModelLibrary[] @relation("ModelPlant")

  // Engineering BOM & Assembly Intelligence relations (Phase B)
  changeRequests EngineeringChangeRequest[] @relation("EcrPlant")

  // Work Package relations
  workPackages WorkPackage[] @relation("WPPlant")

  // Real-Time Industrial Telemetry relations (Phase C)
  telemetrySources TelemetryDataSource[] @relation("TelemetryPlant")

  // Industrial Connectivity (Phase 1)
  gateways EdgeGateway[] @relation("GatewayPlant")

  // Labor Rate relation
  laborRates LaborRate[]

  @@map("plants")
}

model Department {
  id           String   @id @default(cuid())
  name         String
  code         String
  plantId      String
  parentId     String? // self-reference for sub-departments
  supervisorId String? // → User
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plant       Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  parent      Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DeptHierarchy")
  supervisor  User?        @relation("DeptSupervisor", fields: [supervisorId], references: [id])
  assets      Asset[]
  pmSchedules PmSchedule[]

  @@map("departments")
}

model UserPlant {
  id          String   @id @default(cuid())
  userId      String
  plantId     String
  accessLevel String   @default("read") // read, write, admin
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([userId, plantId])
  @@map("user_plants")
}

// ============================================================================
// 4. MAINTENANCE REQUESTS
// ============================================================================

model MaintenanceRequest {
  id                String    @id @default(cuid())
  requestNumber     String    @unique // format MR-YYYYMM-NNNN
  title             String
  description       String?
  priority          String    @default("medium") // low, medium, high, urgent
  category          String? // mechanical, electrical, hydraulic, etc.
  status            String    @default("pending") // pending, in_progress, approved, rejected, converted
  workflowStatus    String    @default("pending") // pending, supervisor_review, approved, rejected, assigned_to_planner, work_order_created, technician_completed, planner_confirmed, satisfactory, supervisor_rejected, closed
  machineDownStatus Boolean?  @default(false)
  assetId           String?
  assetName         String?
  location          String?
  departmentId      String?
  requestedBy       String // → User
  supervisorId      String? // → User
  approvedBy        String? // → User
  assignedPlannerId String? // → User
  workOrderId       String?   @unique // → WorkOrder
  plantId           String?
  plannedStart      DateTime?
  plannedEnd        DateTime?
  estimatedHours    Float?
  slaHours          Float?
  escalationLevel   Int       @default(0) // 0=none, 1=supervisor, 2=manager
  lastEscalatedAt   DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Asset relation
  asset Asset? @relation("MRAsset", fields: [assetId], references: [id])

  // User relations
  requester       User? @relation("MRRequester", fields: [requestedBy], references: [id])
  supervisor      User? @relation("MRSupervisor", fields: [supervisorId], references: [id])
  approver        User? @relation("MRApprover", fields: [approvedBy], references: [id])
  assignedPlanner User? @relation("MRPlanner", fields: [assignedPlannerId], references: [id])

  // Work Order relation
  workOrder WorkOrder?

  // Comments
  comments MaintenanceRequestComment[]

  @@index([plantId])
  @@index([status])
  @@index([priority])
  @@index([departmentId])
  @@index([createdAt])
  @@index([status, priority])
  @@index([plantId, workflowStatus])
  @@map("maintenance_requests")
}

// ============================================================================
// 5. WORK ORDERS
// ============================================================================

model WorkOrder {
  id                   String    @id @default(cuid())
  woNumber             String    @unique // format WO-YYYYMM-NNNN
  title                String
  description          String?
  type                 String    @default("corrective") // preventive, corrective, predictive, inspection, project, emergency
  priority             String    @default("medium") // low, medium, high, critical
  status               String    @default("draft") // draft, requested, approved, planned, assigned, in_progress, waiting_parts, waiting_tools, waiting_shutdown, waiting_permit, on_hold, pending_handover, completed, verified, closed, cancelled
  maintenanceRequestId String?   @unique
  pmScheduleId         String? // → PmSchedule (auto-generated WOs link back)
  assetId              String?
  assetName            String?
  departmentId         String?
  assignedTo           String? // → User
  teamLeaderId         String? // → User
  assignedSupervisorId String? // → User
  assignedBy           String? // → User
  assignmentType       String? // direct, via_supervisor
  assignmentResponseStatus String @default("pending") // pending, accepted, declined
  assignmentRespondedBy String?
  assignmentRespondedAt DateTime?
  assignmentResponseReason String? @db.Text
  plannerId            String? // → User
  estimatedHours       Float?
  actualHours          Float?
  plannedStart         DateTime?
  plannedEnd           DateTime?
  actualStart          DateTime?
  actualEnd            DateTime?
  totalCost            Float     @default(0)
  laborCost            Float     @default(0)
  partsCost            Float     @default(0)
  contractorCost       Float     @default(0)
  failureDescription   String?
  causeDescription     String?
  actionDescription    String?
  tradeActivity        String? // mechanical, electrical, civil, facility, workshop, other
  safetyNotes          String? // Safety precautions / LOTO requirements
  ppeRequired          String? // PPE requirements
  plantId              String?
  notes                String?
  personalTools        String    @default("[]") @db.Text // JSON: [{toolName, toolCode, condition, notes}]
  suggestedParts       String    @default("[]") @db.Text // JSON: [{id, itemId, itemName, itemCode, quantity, unit, notes, status}]
  suggestedTools       String    @default("[]") @db.Text // JSON: [{id, toolId, toolName, toolCode, quantity, notes, status}]
  isLocked             Boolean   @default(false)
  lockedBy             String? // → User
  lockedAt             DateTime?
  lockReason           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Maintenance Request relation
  maintenanceRequest MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id])

  // PM Schedule relation
  pmSchedule PmSchedule? @relation(fields: [pmScheduleId], references: [id])

  // User relations
  assignee           User? @relation("WOAssignedTo", fields: [assignedTo], references: [id])
  teamLeader         User? @relation("WOTeamLeader", fields: [teamLeaderId], references: [id])
  assignedSupervisor User? @relation("WOSupervisor", fields: [assignedSupervisorId], references: [id])
  assigner           User? @relation("WOAssignedBy", fields: [assignedBy], references: [id])
  planner            User? @relation("WOPlanner", fields: [plannerId], references: [id])
  locker             User? @relation("WOLocker", fields: [lockedBy], references: [id])

  // Sub-table relations
  teamMembers WorkOrderTeamMember[]
  teamMemberRequests WoTeamMemberRequest[]
  timeLogs    WorkOrderTimeLog[]
  materials   WorkOrderMaterial[]
  comments    WorkOrderComment[]
  taskExecutions WorkOrderTaskExecution[]

  // Status History relations
  statusHistory WorkOrderStatusHistory[]

  escalationLevel Int       @default(0) // 0=none, 1=supervisor, 2=manager
  lastEscalatedAt DateTime?

  // Repair module relations
  repairMaterialRequests RepairMaterialRequest[]
  repairToolRequests     RepairToolRequest[]
  workOrderDowntimes     WorkOrderDowntime[]
  repairCompletion       RepairCompletion?
  failureRecords         FailureRecord[] @relation("FailureWorkOrder")

  // Work Package relation
  workPackageId String?
  workPackage WorkPackage? @relation(fields: [workPackageId], references: [id])

  // Component Maintenance Intelligence relations
  componentMaintenanceHistory ComponentMaintenanceHistory[] @relation("ComponentWorkOrder")
  installedSpareParts          InstalledSparePart[]          @relation("InstalledSpareWorkOrder")
  componentReplacements        ComponentReplacementHistory[]

  // Spare Part Return relations
  sparePartReturns SparePartReturn[]

  // Damaged Tool Report relations
  damagedToolReports DamagedToolReport[]

  // Work Order - Component tracking
  workOrderComponents WorkOrderComponent[]

  shiftHandovers ShiftHandover[]
  toolTransactions ToolTransaction[] @relation("WOToolTransaction")

  // Labor rate snapshot (applied on WO close/completion)
  laborRateApplied     Float?
  laborCurrency        String? @default("GHS")

  @@index([plantId])
  @@index([workPackageId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([assetId])
  @@index([createdAt])
  @@index([status, priority])
  @@index([assignedTo, status])
  @@index([assignedTo, assignmentResponseStatus])
  @@index([plantId, status])
  @@map("work_orders")
}

model WorkOrderTeamMember {
  id          String   @id @default(cuid())
  workOrderId String
  userId      String
  role        String   @default("assistant") // team_leader, assistant, specialist
  accessLevel String   @default("full") // full (team leader), read_only (other members)
  addedById   String?  // who added this member (direct add or approved request)
  addedVia    String   @default("direct") // "direct" | "request" — tracks how they were added
  assignedAt  DateTime @default(now())

  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedBy    User?     @relation("TMAddedBy", fields: [addedById], references: [id])

  @@unique([workOrderId, userId]) // prevent duplicate team membership
  @@index([workOrderId])
  @@index([userId])
  @@map("wo_team_members")
}

model WoTeamMemberRequest {
  id            String   @id @default(cuid())
  workOrderId   String
  requestedBy   String   // user who requested
  requestedUserId String? // the user they want added (set by planner on approval)
  requestedTrade String? // the trade/skill needed (set by technician on request, e.g. "Electrician")
  role          String   @default("assistant")
  reason        String?  // why they need this person
  status        String   @default("pending") // pending, approved, rejected, cancelled
  reviewedBy    String?  // who approved/rejected
  reviewedAt    DateTime?
  reviewNotes   String?  // approver's notes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  requestedByUser User      @relation("TMReqRequestedBy", fields: [requestedBy], references: [id])
  requestedUser   User?     @relation(fields: [requestedUserId], references: [id])
  reviewedByUser  User?     @relation("TMReqReviewedBy", fields: [reviewedBy], references: [id])

  @@map("wo_team_member_requests")
}

model WorkOrderTimeLog {
  id           String   @id @default(cuid())
  workOrderId  String
  userId       String
  action       String   // start, pause, resume, complete
  duration     Float?   // hours for this log entry (auto-calculated or manual)
  notes        String?
  timestamp    DateTime @default(now())
  loggedById   String?  // → User (team leader who logged time on behalf of a team member)
  isTeamLog    Boolean  @default(false) // true if logged by team leader for a team member

  // Enterprise time tracking fields
  startTime    DateTime? // actual work start time (user-selected or defaults to now)
  endTime      DateTime? // actual work end time (user-selected or defaults to now)
  activityType String   @default("maintenance") // maintenance, travel, inspection, testing, standby, other
  breakMinutes Int      @default(0) // break/lunch minutes deducted from duration
  pauseReason  String?  // break, switch_wo, waiting_parts, other — reason for pausing
  sessionId   String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedBy  User?     @relation("TimeLogLoggedBy", fields: [loggedById], references: [id])

  @@index([workOrderId, timestamp])
  @@index([userId])
  @@map("wo_time_logs")
}

model WorkOrderMaterial {
  id          String   @id @default(cuid())
  workOrderId String
  itemId      String?
  itemName    String?
  quantity    Float?
  unitCost    Float?
  totalCost   Float?
  status      String   @default("requested") // requested, approved, issued, returned
  requestedBy String? // → User
  approvedBy  String? // → User
  issuedBy    String? // → User
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  requester User?     @relation("WOMatRequested", fields: [requestedBy], references: [id])
  approver  User?     @relation("WOMatApproved", fields: [approvedBy], references: [id])
  issuer    User?     @relation("WOMatIssued", fields: [issuedBy], references: [id])

  @@map("wo_materials")
}

model WorkOrderComment {
  id          String   @id @default(cuid())
  workOrderId String
  userId      String
  content     String
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wo_comments")
}

// ============================================================================
// 5.5 WORK PACKAGES
// ============================================================================

model WorkPackage {
  id                   String    @id @default(cuid())
  name                 String
  description          String?   @db.Text
  plantId              String?
  assignedToId         String?   // → User
  scheduledDate        DateTime?
  shift                String?   // morning, afternoon, night
  status               String    @default("planned") // planned, in_progress, completed, cancelled
  totalEstimatedHours  Float     @default(0)
  totalActualHours     Float     @default(0)
  notes                String?   @db.Text
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  workOrders WorkOrder[]
  assignee   User?      @relation("WPAssignedTo", fields: [assignedToId], references: [id])
  plant      Plant?     @relation("WPPlant", fields: [plantId], references: [id])
  createdBy  User       @relation("WPCreatedBy", fields: [createdById], references: [id])

  @@index([plantId])
  @@index([status])
  @@index([assignedToId])
  @@index([scheduledDate])
  @@index([createdAt])
  @@map("work_packages")
}

model WorkOrderTaskExecution {
  id              String    @id @default(cuid())
  workOrderId     String
  templateTaskId  String?   // → PmTemplateTask (if from template)
  taskNumber      Int
  description     String
  taskType        String    @default("check") // check, measure, inspect, lubricate, replace, record
  requiredParts   String?   @db.Text // JSON array of {partName, quantity, unit}
  estimatedMinutes Int?
  status          String    @default("pending") // pending, in_progress, completed, skipped, failed
  completedById   String?   // → User
  completedAt     DateTime?
  notes           String?   @db.Text
  findings        String?   @db.Text
  photos          String?   @db.Text // JSON array of attachment URLs
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workOrder    WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  completedBy  User?           @relation("TaskCompletedBy", fields: [completedById], references: [id])
  templateTask PmTemplateTask? @relation(fields: [templateTaskId], references: [id])

  @@map("wo_task_executions")
}

model StatusTransition {
  id               String   @id @default(cuid())
  entityType       String // maintenance_request, work_order
  fromStatus       String? // null = initial state
  toStatus         String
  allowedRoleSlugs String   @db.Text // JSON string array .Text, e.g. ["supervisor","admin"]
  requiresApproval Boolean  @default(false)
  requiresReason   Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([entityType, fromStatus, toStatus]) // prevent duplicate transition rules
  @@index([entityType, toStatus])
  @@map("status_transitions")
}

// ============================================================================
// 7. AUDIT LOG
// ============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String // create, update, delete, view
  entityType String?
  entityId   String?
  oldValues  String?  @db.Text // JSON string of previous field values
  newValues  String?  @db.Text // JSON string of new field values
  ipAddress     String?
  userAgent     String?
  sessionId     String?
  plantId       String?
  departmentId  String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, createdAt])
  @@map("audit_logs")
}

// ============================================================================
// 7.5 ESCALATION LOG
// ============================================================================

model EscalationLog {
  id            String   @id @default(cuid())
  entityType    String // maintenance_request, work_order, safety_incident
  entityId      String // reference to the entity
  level         Int // 1=first escalation, 2=second escalation
  reason        String // description of why escalated
  notifiedUsers String   @db.Text // JSON array of user IDs .Text who were notified
  createdAt     DateTime @default(now())

  @@map("escalation_logs")
}

// ============================================================================
// 8. COMPANY PROFILE
// ============================================================================

model CompanyProfile {
  id               String    @id @default(cuid())
  companyName      String // legal name of the company
  tradingName      String? // display/brand name
  logo             String? // URL or path to company logo
  address          String?
  city             String?
  region           String?
  country          String?
  postalCode       String?
  phone            String?
  email            String?
  website          String?
  industry         String? // manufacturing, mining, food, etc.
  employeeCount    String? // e.g. "100-500"
  fiscalYearStart  String? // e.g. "January"
  timezone         String    @default("UTC")
  currency         String    @default("GHS") // default currency code
  dateFormat       String    @default("DD/MM/YYYY")
  isSetupComplete  Boolean   @default(false) // has completed initial setup wizard
  setupCompletedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("company_profile")
}

// ============================================================================
// 9. NOTIFICATIONS
// ============================================================================

model Notification {
  id         String   @id @default(cuid())
  userId     String // recipient
  type       String // mr_assigned, mr_approved, mr_rejected, wo_assigned, wo_started, wo_completed, wo_closed, system, info
  title      String
  message    String
  entityType String? // maintenance_request, work_order
  entityId   String? // reference to the entity
  actionUrl  String? // SPA page to navigate to, e.g. "mr-detail"
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ============================================================================
// 10. ASSET MANAGEMENT
// ============================================================================

model AssetCategory {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   AssetCategory?  @relation("AssetCategoryHierarchy", fields: [parentId], references: [id])
  children AssetCategory[] @relation("AssetCategoryHierarchy")
  assets   Asset[]

  @@map("asset_categories")
}

model Asset {
  id                String    @id @default(cuid())
  name              String
  assetTag          String    @unique
  description       String?   @db.Text
  categoryId        String
  serialNumber      String?
  manufacturer      String?
  model             String?
  yearManufactured  Int?
  condition         String    @default("new") // new, good, fair, poor, out_of_service
  status            String    @default("operational") // operational, standby, under_maintenance, decommissioned, disposed
  criticality       String    @default("medium") // low, medium, high, critical
  location          String?
  building          String?
  floor             String?
  area              String?
  plantId           String
  departmentId      String?
  purchaseDate      DateTime?
  purchaseCost      Float?
  warrantyExpiry    DateTime?
  installedDate     DateTime?
  expectedLifeYears Int?
  currentValue      Float?
  depreciationRate  Float?
  imageUrl          String?
  drawingsUrl       String?
  manualUrl         String?
  specification     String    @db.Text // JSON text for flexible specs .Text
  parentId          String?
  isActive          Boolean   @default(true)
  createdById       String
  assignedToId      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  category            AssetCategory        @relation(fields: [categoryId], references: [id])
  parent              Asset?               @relation("AssetHierarchy", fields: [parentId], references: [id])
  children            Asset[]              @relation("AssetHierarchy")
  plant               Plant                @relation(fields: [plantId], references: [id])
  department          Department?          @relation(fields: [departmentId], references: [id])
  createdBy           User                 @relation("AssetCreatedBy", fields: [createdById], references: [id])
  assignedTo          User?                @relation("AssetAssignedTo", fields: [assignedToId], references: [id])
  pmSchedules         PmSchedule[]
  iotDevices          IotDevice[]
  bomAsParent         BillOfMaterial[]     @relation("BomParent")
  bomAsChild          BillOfMaterial[]     @relation("BomChild")
  digitalTwin         DigitalTwin?
  meshBindings        AssetMeshBinding[]   @relation("MeshBoundAsset")
  hotspotRefs         TwinHotspot[]        @relation("HotspotAsset")
  assetModels         AssetModel[]
  maintenanceRequests MaintenanceRequest[] @relation("MRAsset")
  componentVisuals    ComponentVisual[]     @relation("AssetComponentVisuals")

  systemDiagrams       SystemDiagram[]

  // Component Registry / Predictive Maintenance relations
  registryComponents ComponentRegistry[] @relation("RegistryAsset")
  failureRecords     FailureRecord[]     @relation("FailureAsset")
  predictiveModels   PredictiveModel[]   @relation("PredictiveAsset")
  predictionAlerts   PredictionAlert[]   @relation("PredictionAsset")

  // Component Maintenance Intelligence relations
  spatialNodes SpatialNode[] @relation("SpatialAsset")

  // Enterprise Model Library relations (Phase A)
  models ModelLibrary[] @relation("ModelAsset")

  // Engineering BOM & Assembly Intelligence relations (Phase B)
  changeRequests EngineeringChangeRequest[] @relation("EcrAsset")

  // Reliability Engineering relations (Phase D)
  rcmAnalyses     RcmAnalysis[]
  downtimeAnalyses DowntimeAnalysis[]

  @@index([plantId])
  @@index([status])
  @@index([categoryId])
  @@index([criticality])
  @@map("assets")
}

// ============================================================================
// 11. INVENTORY MANAGEMENT
// ============================================================================

model InventoryItem {
  id                 String   @id @default(cuid())
  itemCode           String   @unique
  name               String
  description        String?
  category           String   @default("other") // spare_part, consumable, tool, material, other
  unitOfMeasure      String   @default("each") // each, kg, liter, meter, set, box, roll
  currentStock       Float    @default(0)
  minStockLevel      Float    @default(0)
  maxStockLevel      Float?
  reorderQuantity    Float?
  unitCost           Float?
  supplier           String?
  supplierPartNumber String?
  location           String?
  binLocation        String?
  shelfLocation      String?
  plantId            String
  locationId         String? // → InventoryLocation
  supplierId         String? // → Supplier
  isActive           Boolean  @default(true)
  specification      String   @db.Text // JSON text .Text
  imageUrls          String   @db.Text // JSON text array .Text
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  plant          Plant              @relation(fields: [plantId], references: [id])
  createdBy      User               @relation("InventoryItemCreatedBy", fields: [createdById], references: [id])
  stockMovements StockMovement[]
  invLocation    InventoryLocation? @relation(fields: [locationId], references: [id])
  supplierRef    Supplier?          @relation("ItemSupplier", fields: [supplierId], references: [id])

  adjustments      InventoryAdjustment[]
  requestItems     InventoryRequestItem[]
  transfers        InventoryTransfer[]
  poItems          PurchaseOrderItem[]
  receivingRecords ReceivingRecord[]

  // Repair module relations
  repairMaterialRequests RepairMaterialRequest[]
  sparePartLinks         ComponentSparePart[] @relation("SparePartInventory")

  // Engineering BOM & Assembly Intelligence relations (Phase B)
  bomItems BomRevisionItem[] @relation("BomItemInventory")

  // Spare Part Return relations
  sparePartReturns    SparePartReturn[]   @relation("SparePartReturnItem")
  installedSpareParts InstalledSparePart[] @relation("InstalledSpareInventory")

  @@map("inventory_items")
}

model StockMovement {
  id            String   @id @default(cuid())
  itemId        String
  type          String // in, out, adjustment, transfer
  quantity      Float
  previousStock Float
  newStock      Float
  reason        String?
  referenceType String? // work_order, requisition, return, audit
  referenceId   String?
  performedById String
  notes         String?
  createdAt     DateTime @default(now())

  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  performedBy User          @relation(fields: [performedById], references: [id])

  @@index([itemId, createdAt])
  @@map("stock_movements")
}

// ============================================================================
// 12. PREVENTIVE MAINTENANCE
// ============================================================================

model PmSchedule {
  id                String    @id @default(cuid())
  title             String
  description       String?
  assetId           String
  componentId       String?
  frequencyType     String // daily, weekly, biweekly, monthly, quarterly, semiannual, annual, custom_hours, custom_days, meter_based
  frequencyValue    Int
  lastCompletedDate DateTime?
  nextDueDate       DateTime?
  estimatedDuration Float // hours
  priority          String    @default("medium") // low, medium, high, critical
  assignedToId      String?
  departmentId      String?
  isActive          Boolean   @default(true)
  autoGenerateWO    Boolean   @default(true)
  leadDays          Int       @default(3)
  woTypeId          String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  asset      Asset       @relation(fields: [assetId], references: [id])
  component  ComponentRegistry? @relation("PmScheduleComponent", fields: [componentId], references: [id])
  assignedTo User?       @relation("PmScheduleAssignedTo", fields: [assignedToId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  createdBy  User        @relation("PmScheduleCreatedBy", fields: [createdById], references: [id])

  templateId String?
  template   PmTemplate? @relation(fields: [templateId], references: [id])

  workOrders WorkOrder[]
  trigger    PmTrigger?

  @@index([componentId])
  @@map("pm_schedules")
}

model PmTemplate {
  id                String   @id @default(cuid())
  title             String
  description       String?
  type              String   @default("preventive") // preventive, predictive, inspection, calibration, lubrication
  category          String? // mechanical, electrical, hydraulic, etc.
  estimatedDuration Float // hours
  priority          String   @default("medium") // low, medium, high, critical
  requiredSkills    String?  @db.Text // JSON array of skill names .Text
  requiredTools     String?  @db.Text // JSON array of tool descriptions .Text
  isActive          Boolean  @default(true)
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  schedules PmSchedule[]
  createdBy User             @relation("PmTemplateCreatedBy", fields: [createdById], references: [id])
  tasks     PmTemplateTask[]

  @@map("pm_templates")
}

model PmTemplateTask {
  id               String  @id @default(cuid())
  templateId       String
  taskNumber       Int // sequential order within template
  description      String
  taskType         String  @default("check") // check, measure, inspect, lubricate, replace, record
  requiredParts    String? @db.Text // JSON array of {partName, quantity, unit} .Text
  estimatedMinutes Int?
  sortOrder        Int     @default(0)
  isActive         Boolean @default(true)

  template PmTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  taskExecutions WorkOrderTaskExecution[]

  @@map("pm_template_tasks")
}

model PmTrigger {
  id              String    @id @default(cuid())
  scheduleId      String    @unique // one trigger per schedule
  triggerType     String // time, meter, condition, production_count
  triggerValue    Float // e.g., hours=500, days=30, meters=10000
  triggerConfig   String?   @db.Text // JSON for advanced config .Text (cron expressions, etc.)
  lastTriggeredAt DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  schedule PmSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("pm_triggers")
}

// ============================================================================
// 13. WORK ORDER STATUS HISTORY
// ==============================================================================

model WorkOrderStatusHistory {
  id            String   @id @default(cuid())
  workOrderId   String
  fromStatus    String?
  toStatus      String
  performedById String
  notes         String?
  createdAt     DateTime @default(now())

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  performedBy User      @relation(fields: [performedById], references: [id])

  @@index([workOrderId])
  @@index([createdAt])
  @@map("wo_status_history")
}

// ============================================================================
// 14. MAINTENANCE REQUEST COMMENTS
// ============================================================================

model MaintenanceRequestComment {
  id                   String   @id @default(cuid())
  maintenanceRequestId String
  userId               String
  content              String
  createdAt            DateTime @default(now())

  maintenanceRequest MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mr_comments")
}

// ============================================================================
// 15.5 TRADE / SKILL MANAGEMENT
// ============================================================================

model Trade {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  category    String? // mechanical, electrical, civil, instrumentation, hvac, plumbing, welding
  description String?
  color       String   @default("#6b7280") // badge color hex
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userSkills UserSkill[]

  // Labor Rate relation
  laborRates LaborRate[]

  @@map("trades")
}

model UserSkill {
  id               String   @id @default(cuid())
  userId           String
  tradeId          String
  proficiencyLevel String   @default("intermediate") // beginner, intermediate, advanced, expert
  yearsExperience  Int?
  certified        Boolean  @default(false)
  createdAt        DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([userId, tradeId])
  @@map("user_skills")
}

// ============================================================================
// 15. IoT / CONDITION MONITORING
// ==============================================================================

model IotDevice {
  id              String    @id @default(cuid())
  name            String
  deviceCode      String    @unique // e.g. IOT-0001
  type            String // sensor, gateway, controller, actuator
  protocol        String // mqtt, http, modbus, opcua
  status          String    @default("online") // online, offline, warning, error, maintenance
  location        String?
  plantId         String?
  assetId         String?
  groupId         String?
  parameter       String // e.g. "Temperature", "Vibration"
  unit            String // e.g. "°C", "mm/s", "kPa"
  thresholdMin    Float?
  thresholdMax    Float?
  lastReading     Float?
  lastSeen        DateTime?
  batteryLevel    Int?
  signalStrength  Int?
  firmwareVersion String?
  pollingInterval Int? // seconds between readings
  description     String?
  isActive        Boolean   @default(true)
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  asset     Asset?         @relation(fields: [assetId], references: [id])
  readings  IotReading[]
  alerts    IotAlert[]
  rules     IotAlertRule[]
  createdBy User           @relation("IotDeviceCreatedBy", fields: [createdById], references: [id])

  // Real-Time Industrial Telemetry relations (Phase C)
  telemetryMappings TelemetryMapping[]

  @@map("iot_devices")
}

model IotReading {
  id        String   @id @default(cuid())
  deviceId  String
  value     Float
  unit      String
  timestamp DateTime @default(now())
  isAnomaly Boolean  @default(false)

  device IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("iot_readings")
}

model IotAlert {
  id             String    @id @default(cuid())
  deviceId       String
  ruleId         String?
  severity       String // info, warning, critical
  message        String
  value          Float?
  threshold      Float?
  status         String    @default("active") // active, acknowledged, resolved
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  device IotDevice     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  rule   IotAlertRule? @relation(fields: [ruleId], references: [id])

  @@map("iot_alerts")
}

model IotAlertRule {
  id              String   @id @default(cuid())
  name            String
  deviceId        String
  parameter       String // e.g. "Temperature"
  operator        String // gt, lt, gte, lte, eq
  threshold       Float
  severity        String   @default("warning") // info, warning, critical
  cooldownMinutes Int      @default(5)
  isActive        Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  device    IotDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  alerts    IotAlert[]
  createdBy User       @relation("IotRuleCreatedBy", fields: [createdById], references: [id])

  @@map("iot_alert_rules")
}

// ============================================================================
// 16. TOOL MANAGEMENT
// ============================================================================

model Tool {
  id             String    @id @default(cuid())
  toolCode       String    @unique // e.g. TL-0001
  name           String
  description    String?
  category       String // e.g. "Hand Tool", "Power Tool", "Measurement", "Safety"
  serialNumber   String?   @unique
  status         String    @default("available") // available, checked_out, in_repair, retired, transferred
  condition      String    @default("good") // new, good, fair, poor
  quantity       Int       @default(1) // Usable/issuable units available in stock
  repairQuantity Int       @default(0) // Units held out of usable stock for repair/QC
  location       String?
  plantId        String?
  purchaseDate   DateTime?
  purchaseCost   Float?
  currentValue   Float?
  manufacturer   String?
  model          String?
  assignedToId   String?
  checkedOutAt   DateTime?
  expectedReturn DateTime?
  isActive       Boolean   @default(true)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignedTo   User?             @relation("ToolAssignedTo", fields: [assignedToId], references: [id])
  createdBy    User              @relation("ToolCreatedBy", fields: [createdById], references: [id])
  transactions ToolTransaction[]

  // Repair module relations
  repairToolRequests     RepairToolRequest[]
  repairToolTransfers    ToolTransferRequest[]
  repairToolRequestItems RepairToolRequestItem[] @relation("ToolReqItemTool")
  damagedToolReports      DamagedToolReport[]
  componentRequirements   ComponentToolRequirement[] @relation("ToolComponentReq")
  calibrationRequirement  ToolCalibrationRequirement?

  @@map("tools")
}

model ToolTransaction {
  id            String   @id @default(cuid())
  toolId        String
  type          String // checkout, return, transfer, repair_start, repair_complete, retire
  fromUserId    String? // who had it before (for transfer)
  toUserId      String? // who gets it now (for checkout/transfer)
  notes         String?
  performedById String // who did the action
  createdAt     DateTime @default(now())
  workOrderId   String?

  tool        Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  performedBy User  @relation("ToolTxnPerformedBy", fields: [performedById], references: [id])
  fromUser    User? @relation("ToolTxnFromUser", fields: [fromUserId], references: [id])
  toUser      User? @relation("ToolTxnToUser", fields: [toUserId], references: [id])
  workOrder   WorkOrder? @relation("WOToolTransaction", fields: [workOrderId], references: [id])

