}

// ============================================================================
// SYSTEM CONFIGURATION ( persisted integrations, escalation, etc. )
// ============================================================================

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique // "sms", "escalation", "email", etc.
  config    String   @db.Text // JSON string of config
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_configs")
}

// ============================================================================
// WORK ORDER - COMPONENT TRACKING (Links WOs to specific parts/components)
// ============================================================================

model WorkOrderComponent {
  id                   String   @id @default(cuid())
  workOrderId          String
  componentRegistryId  String
  notes                String?  @db.Text
  createdAt            DateTime @default(now())

  workOrder          WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  componentRegistry  ComponentRegistry  @relation(fields: [componentRegistryId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, componentRegistryId])
  @@index([workOrderId])
  @@index([componentRegistryId])
  @@map("work_order_components")
}

model ToolCalibrationRequirement {
  id                  String   @id @default(cuid())
  toolId              String   @unique
  calibrationRequired Boolean  @default(false)
  lastCalibrationDate DateTime?
  nextCalibrationDue  DateTime?
  calibrationStatus   String   @default("not_required") // not_required, calibrated, due_soon, overdue, failed, expired
  calibrationCertId    String?
  calibratedById       String?
  calibrationIntervalDays Int?
  emergencyOverride    Boolean  @default(false)
  emergencyOverrideReason String?
  emergencyOverrideById String?
  emergencyOverrideAt   DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tool           Tool             @relation(fields: [toolId], references: [id], onDelete: Cascade)
  calibrationRecord CalibrationRecord? @relation(fields: [calibrationCertId], references: [id])
  calibratedBy    User?            @relation("ToolCalBy", fields: [calibratedById], references: [id])
  emergencyOverrideBy User? @relation("ToolCalOverride", fields: [emergencyOverrideById], references: [id])

  @@map("tool_calibration_requirements")
}

model IdempotencyRecord {
  id            String   @id @default(cuid())
  key           String   @unique
  entityType    String
  entityId      String
  action        String
  userId        String
  executedAt    DateTime @default(now())
  responseHash  String   // SHA-256 of the response to detect conflicts
  responseData  String?  @db.Text // JSON response for replay

  @@index([key])
  @@index([entityType, entityId])
  @@map("idempotency_records")
}

// ============================================================================
// LABOR RATE STRUCTURE (Maintenance Costing)
// ============================================================================

model LaborRate {
  id                   String    @id @default(cuid())
  userId               String?   // Specific user override
  tradeId              String?   // Trade-level rate
  plantId              String?   // Plant-specific override (null = all plants)
  normalHourlyRate     Float     // GHS per hour (or configured currency)
  overtimeHourlyRate   Float?    // Overtime multiplier rate (null = 1.5x normal)
  effectiveFrom        DateTime  // When this rate becomes active
  effectiveTo          DateTime? // When this rate expires (null = current)
  currency             String    @default("GHS")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                 User?     @relation("UserLaborRate", fields: [userId], references: [id], onDelete: Cascade)
  trade                Trade?    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  plant                Plant?    @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom, effectiveTo])
  @@index([tradeId, effectiveFrom, effectiveTo])
  @@index([plantId])
  @@map("labor_rates")
}
