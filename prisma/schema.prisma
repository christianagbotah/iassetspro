  expectedCount   Int      @default(0)
  actualCount     Int      @default(0)
  completeness    Float    @default(0) // actual/expected as percentage
  avgQuality      Float?
  gapCount        Int      @default(0)
  anomalyCount    Int      @default(0)
  storageBytes    Int      @default(0)
  createdAt       DateTime @default(now())

