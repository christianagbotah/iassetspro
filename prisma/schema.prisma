  fileUrl           String?
  changeType        String?  // new, revision, correction, withdrawal
  changedById       String
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime @default(now())

  document          EngineeringDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, version])
