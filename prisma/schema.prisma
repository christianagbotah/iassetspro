  asset           Asset?               @relation("PredictionAsset", fields: [assetId], references: [id])
  acknowledgedBy  User?                @relation("PredictionAcknowledged", fields: [acknowledgedById], references: [id])

  @@index([predictiveModelId])
  @@index([componentId])
  @@index([assetId])
  @@index([severity])
  @@index([isAcknowledged])
  @@index([createdAt])
  @@map("prediction_alerts")
}

