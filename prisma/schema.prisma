  @@index([entityType, entityId])
  @@index([status])
  @@index([definitionId])
  @@map("workflow_instances")
}

model WorkflowStepHistory {
  id          String   @id @default(cuid())
  instanceId  String
  stepId      String
  stepName    String
  action      String   // started, completed, approved, rejected, skipped, escalated
  assignedTo  String?  // userId or role
  performedBy String?  // userId
  comment     String?  @db.Text
  durationMs  Int?     // time spent on this step
  variables   Json?    // step-level variables snapshot
  slaStatus   String?  // within_sla, at_risk, breached
  createdAt   DateTime @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([stepId])
  @@map("workflow_step_history")
}

model SlaPolicy {
  id                String   @id @default(cuid())
